		"""
		The abbreviation of a station, for example PLADENCO for the South Platte River at Denver. Separate several with
		commas.
		"""
		abbrev: String
		"The county, in capitals as dwrCounties lists it, for example DENVER or BOULDER."
		county: String
		"The DWR water division, from 1 to 7, for example 1 for the South Platte basin around Denver."
		division: Int
		"The GNIS id of the stream, for example 00201759 for the South Platte River."
		gnisId: String
		"Whether to include historic stations as well. Leave it out for current stations only."
		includeHistoric: Boolean
		"""
		Include third party data? Note: We recommend retrieving data from the Data Provider whenever possible since they
		are responsible for the data and its quality.
		"""
		includeThirdParty: Boolean
