"A Colorado water right as it stands after every court decree."
type DwrWaterRightNetAmount {
	"Type of adjudication."
	adjudicationDate: String
	"""
	A calculated number developed by DWR to rank water rights in order of seniority. The priority of the water right
	is based on the appropriation date and whether the water right is subject to the Subordination Doctrine. The
	appropriation date is the date decreed by the court that the water was first put to the decreed beneficial use.
	The Subordination Doctrine established by the court says water rights that are adjudicated after other water
	rights in their stream system must be subordinate to those rights previously decreed, regardless of their
	appropriation date. To determine whether or not a water right is subject to the Subordination Doctrine, DWR
	determines the "previous adjudication date" associated with the water right.
	"""
	adminNumber: Float
	"""
	The date that water was first put to a specific beneficial use or the date that an open, overt act was taken at
	the intended point of diversion to demonstrate an intent to apply water for beneficial use.
	"""
	appropriationDate: String
	"Water court case number(s) associated with water right."
	associatedCaseNumbers: String
	"Comments."
	comments: String
	"Distance and direction from East/West section line (feet)."
	coordinatesEw: Int
	"Direction of measurement from East/West section line."
	coordinatesEwDir: String
	"Distance and direction from North/South section line (feet)."
	coordinatesNs: Int
	"Direction of measurement from North/South section line."
	coordinatesNsDir: String
	"The county, in capitals, for example DENVER."
	county: String
	"Decree Units (either CFS or AF)."
	decreedUnits: String
	"""
	Beneficial uses of water right: • 0 - STORAGE • 1 - IRRIGATION • 2 - MUNICIPAL • 3 - COMMERCIAL • 4- INDUSTRIAL
	• 5 - RECREATION • 6 - FISHERY • 7 - FIRE • 8 - DOMESTIC • 9 - STOCK • A - AUGMENTATION • B - SUB-BASIN EXPORT •
	C - CHANGE OF USE RETURN FLOW • E - EVAPORATIVE • F - FEDERAL RESERVED • G - GEOTHERMAL • H - HOUSEHOLD USE ONLY
	• K - SNOW MAKING • M - MINIMUM STREAMFLOW • P - POWER GENERATION • Q - OTHER • R - RECHARGE • S - EXPORT FROM
	STATE • T - TRANSMOUNTAIN EXPORT • W - WILDLIFE • X - ALL BENEFICIAL USES.
	"""
	decreedUses: String
	"DWR Water Division."
	division: Int
	"Water source - geographic name information system ID."
	gnisId: String
	"Last date time that this record was modified in the DWR database."
	lastModified: String
	"Latitude value in decimal degrees."
	latitude: Float
	"Accuracy of location coordinates."
	locationAccuracy: String
	"Longitude (decimal degrees)."
	longitude: Float
	"Hyperlink to additional details."
	moreInformation: String
	"Summation of absolute water right flow/volumetric transactions."
	netAbsolute: Float
	"Summation of absolute water right alternate point / exchange flow/volumetric transactions."
	netApexAbsolute: Float
	"Summation of conditional water right alternate point / exchange flow/volumetric transactions."
	netApexConditional: Float
	"Summation of conditional water right flow/volumetric transactions."
	netConditional: Float
	"Used to distinguish the priority of multiple water rights with identical dates."
	orderNumber: Int
	"Well permit number."
	permit: String
	"""
	Principal Meridian of well’s legal location - there are 5 principal meridians in CO: Sixth (S), New Mexico (N),
	Baca (B), Costilla (C), and Ute (U).
	"""
	pm: String
	"""
	The previous adjudication date field allows water rights to be ordered by priority with all rights awarded
	subsequent to a previous adjudication being junior.
	"""
	priorAdjudicationDate: String
	"An early District Court’s method to indicate a water right’s seniority in a water drainage."
	priorityNumber: String
	"Legal location: 10 acre quarter section."
	q10: String
	"Legal location: 160 acre quarter section."
	q160: String
	"Legal location: 40 acre quarter section."
	q40: String
	"""
	Legal location: A number in the format “nnnd” where “nnn” is the range number and “d” is the direction either
	East or West.
	"""
	range: String
	"Flag indicating that the water right has decreed amounts that vary by date."
	seasonalLimitation: String
	"""
	Section number - township, range divided into 36 one square mile sections; “U” indicates location in Ute
	Correction (Division 7 only).
	"""
	section: String
	"""
	Distance in miles to the confluence with the next downstream water source (or distance to state line).
	"""
	streamMile: Float
	"Name of Structure."
	structureName: String
	"Type of structure."
	structureType: String
	"Legal location: Township number and direction."
	township: String
	"The x (Easting) component of the Universal Transverse Mercator system. (Zone 13, NAD83 datum)."
	utmX: Float
	"The y (Northing) component of the Universal Transverse Mercator system. (Zone 13, NAD83 datum)."
	utmY: Float
	"DWR Water District."
	waterDistrict: Int
	"NA."
	waterRightNetAmtNum: Int
	"Name of the water source as specified in the court case."
	waterSource: String
	"DWR unique structure identifier."
	wdid: String
}

