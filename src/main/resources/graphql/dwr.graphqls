	# Dams that the Colorado Dam Safety program keeps records of.

	"""
	Dams that the Colorado Dam Safety program regulates (jurisdictional dams), with their hazard class (High,
	Significant or Low), height, the stream they hold back, the town downstream, the emergency action plan and the
	date of the last inspection. Answers which high hazard dams lie in Boulder County.
	DWR describes it as: Returns jurisdictional dam info.
	"""
	dwrJurisdictionalDams(
		"The county, in capitals as dwrCounties lists it, for example DENVER or BOULDER."
		county: String
		"Dam ID. A * at the start or the end of the value matches any text there."
		damId: String
		"The DWR water division, from 1 to 7, for example 1 for the South Platte basin around Denver."
		division: Int
		"""
		Only results whose modified is on or after this date. Date this record was created or last modified. Use this to
		restrict your data grab to changes since your last grab. (Eg, if you grab every 3 days, set modified = today
		minus 3 days.)
		"""
		minModified: String
		"The DWR water district, for example 8 for the South Platte River through Denver."
		waterDistrict: Int
		"""
		The latitude of the centre of a location search, in decimal degrees, for example 39.7392 in Denver. Give it with
		longitude and radius.
		"""
		latitude: Float
		"""
		The longitude of the centre of a location search, in decimal degrees, for example -104.9903 in Denver.
		"""
		longitude: Float
		"""
		The radius of a location search, in the units given, up to 150 miles. Smaller values answer much faster.
		"""
		radius: Float
		"The units of the radius. Leave it out for miles."
		units: DwrRadiusUnits
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): DwrJurisdictionalDamPage

	"""
	Small dams below the size that the Dam Safety program regulates (non-jurisdictional dams), such as ponds, with
	their height, stream and storage.
	DWR describes it as: Returns non-jurisdictional dam info.
	"""
	dwrNonJurisdictionalDams(
		"The county, in capitals as dwrCounties lists it, for example DENVER or BOULDER."
		county: String
		"Dam ID. A * at the start or the end of the value matches any text there."
		damId: String
		"The DWR water division, from 1 to 7, for example 1 for the South Platte basin around Denver."
		division: Int
		"""
		Only results whose modified is on or after this date. Date this record was created or last modified. Use this to
		restrict your data grab to changes since your last grab. (Eg, if you grab every 3 days, set modified = today
		minus 3 days.)
		"""
		minModified: String
		"The DWR water district, for example 8 for the South Platte River through Denver."
		waterDistrict: Int
		"""
		The latitude of the centre of a location search, in decimal degrees, for example 39.7392 in Denver. Give it with
		longitude and radius.
		"""
		latitude: Float
		"""
		The longitude of the centre of a location search, in decimal degrees, for example -104.9903 in Denver.
		"""
		longitude: Float
		"""
		The radius of a location search, in the units given, up to 150 miles. Smaller values answer much faster.
		"""
		radius: Float
		"The units of the radius. Leave it out for miles."
		units: DwrRadiusUnits
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): DwrNonJurisdictionalDamPage

	"""
	Small dams built to water livestock or to control erosion, filed with DWR, with the stream, the dam height and
	the capacity of the tank.
	DWR describes it as: Returns livestock and erosion control info.
	"""
	dwrLivestockAndErosionControlDams(
		"The county, in capitals as dwrCounties lists it, for example DENVER or BOULDER."
		county: String
		"The DWR water division, from 1 to 7, for example 1 for the South Platte basin around Denver."
		division: Int
		"""
		Only results whose modified is on or after this date. Date this record was created or last modified. Use this to
		restrict your data grab to changes since your last grab. (Eg, if you grab every 3 days, set modified = today
		minus 3 days.)
		"""
		minModified: String
		"Permit application receipt number."
		receipt: Int
		"The DWR water district, for example 8 for the South Platte River through Denver."
		waterDistrict: Int
		"""
		The latitude of the centre of a location search, in decimal degrees, for example 39.7392 in Denver. Give it with
		longitude and radius.
		"""
		latitude: Float
		"""
		The longitude of the centre of a location search, in decimal degrees, for example -104.9903 in Denver.
		"""
		longitude: Float
		"""
		The radius of a location search, in the units given, up to 150 miles. Smaller values answer much faster.
		"""
		radius: Float
		"The units of the radius. Leave it out for miles."
		units: DwrRadiusUnits
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): DwrLivestockOrErosionControlDamPage

	# Climate stations whose records DWR gathers for its water models.

	"""
	Weather stations whose records Colorado gathers for its water models, from NOAA, Northern Water and others, such
	as Denver International Airport (station 62). Use it for the station number that the climate value fields take.
	For current weather and forecasts, use the National Weather Service fields.
	DWR describes it as: Returns Climate Stations.
	"""
	dwrClimateStations(
		"The county, in capitals as dwrCounties lists it, for example DENVER or BOULDER."
		county: String
		"The DWR water division, from 1 to 7, for example 1 for the South Platte basin around Denver."
		division: Int
		"""
		Only results whose modified is on or after this date. Date this record was created or last modified. Use this to
		restrict your data grab to changes since your last grab. (Eg, if you grab every 3 days, set modified = today
		minus 3 days.)
		"""
		minModified: String
		"""
		Site ID. Separate several with commas. A * at the start or the end of the value matches any text there.
		"""
		siteId: String
		"Station Name. A * at the start or the end of the value matches any text there."
		stationName: String
		"The DWR water district, for example 8 for the South Platte River through Denver."
		waterDistrict: Int
		"""
		The latitude of the centre of a location search, in decimal degrees, for example 39.7392 in Denver. Give it with
		longitude and radius.
		"""
		latitude: Float
		"""
		The longitude of the centre of a location search, in decimal degrees, for example -104.9903 in Denver.
		"""
		longitude: Float
		"""
		The radius of a location search, in the units given, up to 150 miles. Smaller values answer much faster.
		"""
		radius: Float
		"The units of the radius. Leave it out for miles."
		units: DwrRadiusUnits
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): DwrClimateStationPage

	"""
	What each climate station measures, such as the highest and lowest temperature, precipitation or frost dates,
	with the period of its record.
	DWR describes it as: Returns Climate Station Data Types.
	"""
	dwrClimateStationDataTypes(
		"The county, in capitals as dwrCounties lists it, for example DENVER or BOULDER."
		county: String
		"The DWR water division, from 1 to 7, for example 1 for the South Platte basin around Denver."
		division: Int
		"Measurement Type. A * at the start or the end of the value matches any text there."
		measType: String
		"""
		Only results whose porLastModified is on or after this date. Date this record was created or last modified. Use
		this to restrict your data grab to changes since your last grab. (Eg, if you grab every 3 days, set modified =
		today minus 3 days.)
		"""
		minPorLastModified: String
		"""
		Site ID. Separate several with commas. A * at the start or the end of the value matches any text there.
		"""
		siteId: String
		"Station Name. A * at the start or the end of the value matches any text there."
		stationName: String
		"The DWR water district, for example 8 for the South Platte River through Denver."
		waterDistrict: Int
		"""
		The latitude of the centre of a location search, in decimal degrees, for example 39.7392 in Denver. Give it with
		longitude and radius.
		"""
		latitude: Float
		"""
		The longitude of the centre of a location search, in decimal degrees, for example -104.9903 in Denver.
		"""
		longitude: Float
		"""
		The radius of a location search, in the units given, up to 150 miles. Smaller values answer much faster.
		"""
		radius: Float
		"The units of the radius. Leave it out for miles."
		units: DwrRadiusUnits
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): DwrClimateStationDataTypePage

	"""
	Daily values of a climate station, such as the highest temperature in degrees Fahrenheit or the precipitation in
	inches, for example the highest temperature at Denver International Airport (stationNum 62, measType MaxTemp).
	DWR describes it as: Returns Climate Station Time Series Day.
	"""
	dwrClimateStationDailyValues(
		"Date of measurement. Write a date as 2026-10-01, or a date and time as 2026-10-01 18:00."
		measDate: String
		"Only results whose measDate is on or after this date. Date of measurement."
		minMeasDate: String
		"Only results whose measDate is on or before this date. Date of measurement."
		maxMeasDate: String
		"""
		The measurement type, such as MaxTemp, MinTemp or Precip, as dwrClimateStationMeasurementTypes lists them.
		"""
		measType: String
		"""
		Only results whose modified is on or after this date. Date this record was created or last modified. Use this to
		restrict your data grab to changes since your last grab. (Eg, if you grab every 3 days, set modified = today
		minus 3 days.)
		"""
		minModified: String
		"""
		Site ID. Separate several with commas. A * at the start or the end of the value matches any text there.
		"""
		siteId: String
		"""
		The DWR number of the station, for example 62 for Denver International Airport or 637 for the South Platte River
		at Denver.
		"""
		stationNum: Int
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): DwrClimateStationDailyValuePage

	"""
	Monthly values of a climate station: the lowest, highest, mean and total value of a measurement type for each
	month, for example the precipitation at Denver International Airport (stationNum 62, measType Precip) in 2025.
	DWR describes it as: Returns Climate Station Time Series Month.
	"""
	dwrClimateStationMonthlyValues(
		"Calendar Year."
		calYear: Int
		"Only results whose calYear is at least this value. Calendar Year."
		minCalYear: Int
		"Only results whose calYear is at most this value. Calendar Year."
		maxCalYear: Int
		"""
		The measurement type, such as MaxTemp, MinTemp or Precip, as dwrClimateStationMeasurementTypes lists them.
		"""
		measType: String
		"""
		Only results whose modified is on or after this date. Date this record was created or last modified. Use this to
		restrict your data grab to changes since your last grab. (Eg, if you grab every 3 days, set modified = today
		minus 3 days.)
		"""
		minModified: String
		"""
		Site ID. Separate several with commas. A * at the start or the end of the value matches any text there.
		"""
		siteId: String
		"""
		The DWR number of the station, for example 62 for Denver International Airport or 637 for the South Platte River
		at Denver.
		"""
		stationNum: Int
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): DwrClimateStationMonthlyValuePage

	"""
	The last frost of the spring and the first frost of the fall in each year at a Colorado climate station, at 28
	and at 32 degrees Fahrenheit. Answers when the last spring frost came in Denver this year (stationNum 62, Denver
	International Airport).
	DWR describes it as: Returns Climate Station Frost Dates.
	"""
	dwrClimateStationFrostDates(
		"Calendar Year."
		calYear: Int
		"Only results whose calYear is at least this value. Calendar Year."
		minCalYear: Int
		"Only results whose calYear is at most this value. Calendar Year."
		maxCalYear: Int
		"""
		The DWR number of the station, for example 62 for Denver International Airport or 637 for the South Platte River
		at Denver.
		"""
		stationNum: Int
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): DwrClimateStationFrostDatesPage

	# Reference tables: the codes and names that the other DWR fields take as filters.

	"""
	The names of Colorado's counties as the county filters of the DWR fields take them, in capitals, such as DENVER.
	DWR describes it as: Returns county names.
	"""
	dwrCounties(
		"The county, in capitals as dwrCounties lists it, for example DENVER or BOULDER."
		county: String
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): DwrCountyPage

	"""
	Colorado's water divisions, one for each major river basin, such as division 1 for the South Platte.
	DWR describes it as: Returns list of Water Divisions.
	"""
	dwrWaterDivisions(
		"The DWR water division, from 1 to 7, for example 1 for the South Platte basin around Denver."
		division: Int
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): DwrWaterDivisionPage

	"""
	The water districts inside each Colorado water division, with their names, such as district 8 on the South
	Platte through Denver.
	DWR describes it as: Returns list of Water Districts.
	"""
	dwrWaterDistricts(
		"The DWR water division, from 1 to 7, for example 1 for the South Platte basin around Denver."
		division: Int
		"The DWR water district, for example 8 for the South Platte River through Denver."
		waterDistrict: Int
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): DwrWaterDistrictPage

	"""
	The designated groundwater basins of Colorado's Eastern Plains, where water users rely mostly on groundwater.
	DWR describes it as: Returns list of designated basins.
	"""
	dwrDesignatedBasins(
		"""
		Eight established geographic areas in Colorado's Eastern Plains where users rely primarily on groundwater for
		water supply. A * at the start or the end of the value matches any text there.
		"""
		designatedBasinName: String
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): DwrDesignatedBasinPage

	"""
	The groundwater management districts inside the designated basins, which have powers of their own over wells.
	DWR describes it as: Returns Management Districts.
	"""
	dwrManagementDistricts(
		"""
		Thirteen local districts, within the Designated Basins, with additional administrative authority. A * at the
		start or the end of the value matches any text there.
		"""
		managementDistrictName: String
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): DwrManagementDistrictPage

	"""
	The groundwater level publications that group the monitoring wells, such as DENVER BASIN.
	DWR describes it as: Returns list of Groundwater Publications.
	"""
	dwrGroundwaterPublications(
		"""
		Name of DWR Basin Summary publication in which well is included, if applicable. A * at the start or the end of
		the value matches any text there.
		"""
		publicationName: String
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): DwrGroundwaterPublicationPage

	"""
	The kinds of action a well permit goes through, such as Application Received, which dwrWellPermitActions takes
	as actionName.
	DWR describes it as: Returns list of Permit Action Names.
	"""
	dwrPermitActionNames(
		"Action name. A * at the start or the end of the value matches any text there."
		actionName: String
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): DwrPermitActionNamePage

	"""
	The parameter codes of the DWR live gauges, such as DISCHRG for discharge and GAGE_HT for gage height.
	DWR describes it as: Returns list of Telemetry Parameters.
	"""
	dwrTelemetryParameters(
		"Parameter string. A * at the start or the end of the value matches any text there."
		parameter: String
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): DwrTelemetryParameterPage

	"""
	The measurement types of the climate stations, such as MaxTemp, MinTemp and Precip.
	DWR describes it as: Returns list of Climate Station Measurement Types.
	"""
	dwrClimateStationMeasurementTypes(
		"Measurement Type. A * at the start or the end of the value matches any text there."
		measType: String
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): DwrClimateStationMeasurementTypePage

	"""
	The codes that say whether a water structure is in use, which dwrStructures returns as ciuCode.
	DWR describes it as: Returns list of Current In Use Codes.
	"""
	dwrCurrentInUseCodes(
		"Current in use code of structure. A * at the start or the end of the value matches any text there."
		ciuCode: String
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): DwrCurrentInUseCodePage

	"""
	The observation codes of diversion records, which say how a value was obtained.
	DWR describes it as: Returns list of Div Rec Observation Codes.
	"""
	dwrDiversionRecordObservationCodes(
		"Observation Code. A * at the start or the end of the value matches any text there."
		obsCode: String
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): DwrDiversionRecordObservationCodePage

	"""
	The kinds of diversion record that DWR keeps, such as water classes, reservoir stage and volume, and comments.
	DWR describes it as: Returns list of Div Rec Types.
	"""
	dwrDiversionRecordTypes(
		"""
		Type of record: diversion; stage/volume; or comment. A * at the start or the end of the value matches any text
		there.
		"""
		divRecType: String
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): DwrDiversionRecordTypePage

	"""
	The codes that explain why a structure did not divert water in a year.
	DWR describes it as: Returns list of Diversion Not Used Codes.
	"""
	dwrDiversionNotUsedCodes(
		"""
		Code/reason if structure is not used. A * at the start or the end of the value matches any text there.
		"""
		notUsedCode: String
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): DwrDiversionNotUsedCodePage

	"""
	The meaning of the flags on station readings, such as whether a value is observed, estimated or affected by ice.
	DWR describes it as: Returns list of Station Flags and their descriptions.
	"""
	dwrStationFlags(
		"Data Source that uses this flag. A * at the start or the end of the value matches any text there."
		dataSource: String
		"Description of the flag. A * at the start or the end of the value matches any text there."
		description: String
		"Short code for the flag. A * at the start or the end of the value matches any text there."
		flag: String
		"Column for this flag. A * at the start or the end of the value matches any text there."
		flagColumn: String
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): DwrStationFlagPage

	"""
	The kinds of meter reading submission, such as Meter Test or Meter Installation.
	DWR describes it as: Returns list of Meter Reading Submission Types.
	"""
	dwrMeterReadingSubmissionTypes(
		"Submission Type. A * at the start or the end of the value matches any text there."
		submissionType: String
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): DwrMeterReadingSubmissionTypePage
}

# The types of the DWR fields.

"One page of TelemetryStation results, as DWR sends every search."
type DwrTelemetryStationPage {
	"The number of this page, from 1, or 0 for an empty search."
	PageNumber: Int
	"The number of pages the search fills at the size asked for."
	PageCount: Int
	"The number of results on this page."
	ResultCount: Int
	"When DWR answered, in Colorado time."
	ResultDateTime: String
	"The results on this page."
	ResultList: [DwrTelemetryStation]
}

"A DWR live gauge on a river, ditch or reservoir, with its latest reading."
type DwrTelemetryStation {
	"Station Abbreviation."
	abbrev: String
	"Contributing Area."
	contrArea: Float
	"The county, in capitals, for example DENVER."
	county: String
	"Full data source description."
	dataSource: String
	"Primary source/provider of well measurement data."
	dataSourceAbbrev: String
	"DWR Water Division."
	division: Int
	"Drainage Area."
	drainArea: Float
	"Station status (eg Ice Affected)."
	flagA: String
	"Data publish status (eg Raw, Provisional, Published)."
	flagB: String
	"Water source - geographic name information system ID."
	gnisId: String
	"HUC 10."
	huc10: String
	"Latitude value in decimal degrees."
	latitude: Float
	"Accuracy of location coordinates."
	locationAccuracy: String
	"Longitude (decimal degrees)."
	longitude: Float
	"Measurement Date/Time of last recorded parameter."
	measDateTime: String
	"Last recorded reading of meas_value parameter."
	measValue: Float
	"Last date time that this record was modified in the DWR database."
	modified: String
	"Hyperlink to additional details."
	moreInformation: String
	"Parameter that last recorded meas_value is reporting."
	parameter: String
	"Last recorded stage (feet) associated with measurement parameter."
	stage: Float
	"Station Name."
	stationName: String
	"End of period of record for this station."
	stationPorEnd: String
	"Beginning of period of record for this station."
	stationPorStart: String
	"Station Status."
	stationStatus: String
	"Station Type."
	stationType: String
	"""
	Distance in miles to the confluence with the next downstream water source (or distance to state line).
	"""
	streamMile: Float
	"Type of structure."
	structureType: String
	"Is data from third party?"
	thirdParty: Boolean
	"Units of measure."
	units: String
