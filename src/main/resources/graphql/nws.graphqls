		"A state or territory code, or a marine area code, for example CO for Colorado."
		area: NwsAreaCode
		"A point as latitude,longitude, for example 39.7392,-104.9903 for downtown Denver."
		point: String
		"A marine region code, for example PA for the Pacific."
		region: NwsMarineRegion
		"Only alerts for land, or only alerts for marine areas."
		regionType: NwsAlertRegionType
