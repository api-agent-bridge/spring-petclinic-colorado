	setId: String
	callSign: String
	transmitterFrequency: String
	siteName: String
	siteCity: String
	siteState: String
	"The SAME codes of the counties the transmitter covers, such as 008031 for Denver County."
	sameCodes: [String]
	"The codes of the counties the transmitter covers, such as COC031 for Denver County."
	counties: [String]
}

"A list of text bulletins."
type NwsTextProductCollection {
	"The items of the list."
	items: [NwsTextProduct]
}

"A text bulletin of the National Weather Service, such as an Area Forecast Discussion."
type NwsTextProduct {
	id: String
	wmoCollectiveId: String
	issuingOffice: String
	issuanceTime: String
	productCode: String
	productName: String
	productText: String
}

"The locations that issue text bulletins, by code with their name."
type NwsTextProductLocationCollection {
	"The locations by code, with their name. The name is null for some codes."
	locations: [NwsStringEntry]
}

"A code with its name."
type NwsStringEntry {
	"The key."
	key: String
	"The value of the key."
	value: String
}

"A list of types of text bulletin."
type NwsTextProductTypeCollection {
	"The items of the list."
	items: [NwsTextProductType]
}

"A type of text bulletin, by code and name."
type NwsTextProductType {
	productCode: String
	productName: String
}

"A list of zones of the National Weather Service."
type NwsZoneCollection {
	type: String
	"The items of the list, each a GeoJSON feature with the item under properties."
	features: [NwsZoneFeature]
}

"A zone as a GeoJSON feature. The zone itself is under properties."
type NwsZoneFeature {
	id: String
	type: String
	properties: NwsZone
}

"""
A zone of the National Weather Service: a forecast zone, a county, a fire weather zone or a marine zone.
"""
type NwsZone {
	"A geometry represented in Well-Known Text (WKT) format."
	geometry: String
	"""
	UGC identifier for a NWS forecast zone or county.
	The first two letters will correspond to either a state code or marine area code (see
	#/components/schemas/StateTerritoryCode and #/components/schemas/MarineAreaCode for lists of valid letter
	combinations).
	The third letter will be Z for public/fire zone or C for county.
	"""
	id: String
	type: String
	name: String
	effectiveDate: String
	expirationDate: String
	state: String
	forecastOffice: String
	gridIdentifier: String
	awipsLocationIdentifier: String
	cwa: [String]
	forecastOffices: [String]
	timeZone: [String]
	observationStations: [String]
	radarStation: String
}

"The forecast of a zone in words, as a GeoJSON feature. The forecast is under properties."
type NwsZoneForecastFeature {
	id: String
	type: String
	"An object representing a zone area forecast."
	properties: NwsZoneForecast
}

"The forecast of a zone in words."
type NwsZoneForecast {
	"A geometry represented in Well-Known Text (WKT) format."
	geometry: String
	"An API link to the zone this forecast is for."
	zone: String
	"The time this zone forecast product was published."
	updated: String
	"An array of forecast periods."
	periods: [NwsZoneForecastPeriod]
}

"One period of a zone forecast, such as Tonight, with the forecast in words."
type NwsZoneForecastPeriod {
	"A sequential identifier number."
	number: Int
	"A textual description of the period."
	name: String
	"A detailed textual forecast for the period."
	detailedForecast: String
}

