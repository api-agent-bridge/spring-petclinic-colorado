		"Only the data that this radar data server received, for example rds."
		host: String
	): NwsRadarStationFeature

	"""
	The weather radar stations of the National Weather Service, filtered by type such as WSR-88D, with their
	location, elevation, data latency and operating status.
	"""
	nwsRadarStations(
		"""
		Radar types, for example WSR-88D for the weather radars of the national network or TDWR for the terminal Doppler
		radars at airports. Separate several types with commas.
		"""
		stationType: String
		"Only the data that this radar data server reports, for example rds."
		reportingHost: String
		"Only the data that this radar data server received, for example rds."
		host: String
	): NwsRadarStationCollection

	"""
	The recent alarms of one weather radar station, with their message, status and time. KFTG is the radar that
	covers Denver.
	"""
	nwsRadarStationAlarms(
		"The id of an observation station, for example KDEN for Denver International Airport."
		stationId: String!
	): NwsRadarStationAlarmCollection

	"""
	The radar data files that one radar data server received most recently, by station, for checking whether a radar
	delivers data. Pass host rds and station KFTG for the radar that covers Denver.
	"""
	nwsRadarQueue(
		"The radar data server, for example rds."
		host: NwsRadarDataServer!
		"The time range in which the files arrived, as an ISO 8601 interval."
		arrived: String
		"The time range in which the files were created, as an ISO 8601 interval."
		created: String
		"The time range in which the files were published, as an ISO 8601 interval."
		published: String
		"Only files from this radar station, for example KFTG for the radar that covers Denver."
		station: String
		"Only files of this type, for example intermediate."
		type: String
		"Only files of this feed, for example NEXRAD2."
		feed: String
		"Only files of this resolution version, for example 6."
		resolution: Int
		"""
		The number of results to return, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): NwsRadarQueue

	# NOAA Weather Radio: the transmitters that broadcast forecasts and alerts on VHF.

	"""
	One NOAA Weather Radio transmitter by its call sign, with its frequency, site and the counties it covers. KEC76
	broadcasts for Denver on 162.550 MHz.
	"""
	nwsWeatherRadioTransmitter(
		"The call sign of a NOAA Weather Radio transmitter, for example KEC76 for Denver."
		callSign: String!
	): NwsTransmitter

	"""
	The NOAA Weather Radio transmitters that cover one county, such as COC031 for Denver County. The service repeats
	each transmitter many times: 256 entries for the 4 transmitters that cover Denver County.
	"""
	nwsCountyWeatherRadioTransmitters(
		"The type of zone, which is county."
		type: NwsCountyZoneType!
		"The code of a county, for example COC031 for Denver County."
		zoneId: String!
	): NwsTransmitterCollection

	"""
	The transmitters of NOAA Weather Radio, which broadcast forecasts and alerts on VHF, 500 to a page, with their
	call sign, frequency, site and the counties they cover. The cursor argument moves to the next page.
	"""
	nwsWeatherRadioTransmitters(
		"""
		The cursor of the next page: the value after cursor= in the pagination.next link of the previous answer, with
		%3D written as =.
		"""
		cursor: String
	): NwsTransmitterCollection

	# NWS aviation weather: the advisories of the Center Weather Service Units at the air traffic control centers,
	# and SIGMETs, the warnings of hazards to aircraft in flight.

	"""
	One Center Weather Service Unit, the team of National Weather Service forecasters at an air route traffic
	control center, by its id, with its address and contact details. ZDV is the Denver center in Longmont, which
	covers the airspace over Colorado.
	"""
	nwsCenterWeatherServiceUnit(
		"The id of a Center Weather Service Unit, for example ZDV for the Denver center."
		cwsuId: NwsCenterWeatherServiceUnitId!
	): NwsOffice

	"""
	The Center Weather Advisories that one Center Weather Service Unit issued: short warnings for pilots about
	thunderstorms, turbulence or icing in its airspace, valid for a few hours. ZDV is the Denver center, which
	covers Colorado.
	"""
	nwsCenterWeatherAdvisories(
		"The id of a Center Weather Service Unit, for example ZDV for the Denver center."
		cwsuId: NwsCenterWeatherServiceUnitId!
	): NwsCenterWeatherAdvisoryCollection

	"""
	The SIGMETs that one air traffic service unit issued on one day, for example KKCI, the Aviation Weather Center,
	on 2026-10-12.
	"""
	nwsSigmetsOfAirTrafficServiceUnitOnDate(
		"An air traffic service unit, for example KKCI for the Aviation Weather Center."
		atsu: String!
		"A day as YYYY-MM-DD, for example 2026-10-12."
		date: String!
	): NwsSigmetCollection

	"""
	SIGMETs, the warnings to aircraft in flight about hazards such as severe turbulence, icing, thunderstorms or
	volcanic ash, filtered by issuing unit, day, time range or sequence. KKCI is the Aviation Weather Center, which
	issues the SIGMETs for the continental United States.
	"""
	nwsSigmets(
		"The start of the time range, in ISO 8601, for example 2026-10-12T00:00:00Z."
		start: String
		"The end of the time range, in ISO 8601, for example 2026-10-12T12:00:00Z."
		end: String
		"A day as YYYY-MM-DD, for example 2026-10-12."
		date: String
		"An air traffic service unit, for example KKCI for the Aviation Weather Center."
		atsu: String
		"The sequence number of a SIGMET, for example 36E."
		sequence: String
	): NwsSigmetCollection

	"""
	Every SIGMET that one air traffic service unit issued in the past seven days, for example KKCI, the Aviation
	Weather Center. For KKCI that is several hundred SIGMETs and about 600 KB, so
	nwsSigmetsOfAirTrafficServiceUnitOnDate, which narrows the list to one day, is usually the better field.
	"""
	nwsSigmetsOfAirTrafficServiceUnit(
		"An air traffic service unit, for example KKCI for the Aviation Weather Center."
		atsu: String!
	): NwsSigmetCollection

	"""
	One SIGMET by its issuing unit, its day and its time of issue, the three parts at the end of the properties.id
	of a SIGMET in the lists.
	"""
	nwsSigmet(
		"An air traffic service unit, for example KKCI for the Aviation Weather Center."
		atsu: String!
		"A day as YYYY-MM-DD, for example 2026-10-12."
		date: String!
		"The time of issue as HHMM in UTC, for example 1155."
		time: String!
	): NwsSigmetFeature
}

"A page of weather alerts of the National Weather Service, with the link to the next page."
type NwsAlertCollection {
	type: String
	"The items of the list, each a GeoJSON feature with the item under properties."
	features: [NwsAlertFeature]
	"A title describing the alert collection"
	title: String
	"The last time a change occurred to this collection"
	updated: String
	"Links for retrieving more data from paged data sets"
	pagination: NwsPaginationInfo
}

"A weather alert as a GeoJSON feature. The alert itself is under properties."
type NwsAlertFeature {
	id: String
	type: String
	"The alert."
	properties: NwsAlert
}

"""
A weather alert of the National Weather Service: a watch, a warning, an advisory or a statement, in the Common
Alerting Protocol (CAP).
"""
type NwsAlert {
	"The identifier of the alert message."
	id: String
	"A textual description of the area affected by the alert."
	areaDesc: String
	"Lists of codes for NWS public zones and counties affected by the alert."
	geocode: NwsAlertGeocode
	"""
	An array of API links for zones affected by the alert. This is an API-specific extension field and is not part
	of the CAP specification.
	"""
	affectedZones: [String]
	"A list of prior alerts that this alert updates or replaces."
	references: [NwsAlertReference]
	"The time of the origination of the alert message."
	sent: String
	"The effective time of the information of the alert message."
	effective: String
	"The expected time of the beginning of the subject event of the alert message."
	onset: String
	"The expiry time of the information of the alert message."
	expires: String
	"The expected end time of the subject event of the alert message."
	ends: String
	status: String
	messageType: String
	"The code denoting the category of the subject event of the alert message."
	category: String
	severity: String
	certainty: String
	urgency: String
	"The text denoting the type of the subject event of the alert message."
	event: String
	"Email address of the NWS webmaster."
	sender: String
	"The text naming the originator of the alert message."
	senderName: String
	"The text headline of the alert message."
	headline: String
	"The text describing the subject event of the alert message."
	description: String
	"The text describing the recommended action to be taken by recipients of the alert message."
	instruction: String
	"""
	The text note accompanying the alert message. Per CAP spec, this should accompany alerts with a status of
	"Test".
	"""
	note: String
	"""
	The code denoting the type of action recommended for the target audience.
	This corresponds to responseType in the CAP specification.
	"""
	response: String
	"""
	Further parameters of the alert from the NWS CAP specification, such as NWSheadline, VTEC and eventEndingTime.
	"""
	parameters: [NwsStringListEntry]
	"The code denoting the intended distribution of the alert message."
	scope: String
	"The code denoting the special handling of the alert message."
	code: String
	"The code denoting the language of the info sub-element of the alert message."
	language: String
	"The identifier of the hyperlink associating additional information within the alert message."
	web: String
	"The codes of the kind of event, such as the SAME code and the NWS code."
	eventCode: [NwsStringListEntry]
	"The id of the alert that replaced this one, when one did."
	replacedBy: String
	"When this alert was replaced, when it was."
	replacedAt: String
}

"The codes of the zones and counties an alert covers."
type NwsAlertGeocode {
	"A list of NWS public zone or county identifiers."
	UGC: [String]
	"A list of SAME (Specific Area Message Encoding) codes for affected counties."
	SAME: [String]
}

"An earlier alert that this alert updates or replaces."
type NwsAlertReference {
	"The identifier of the alert message."
	identifier: String
	"The sender of the prior alert."
	sender: String
	"The time the prior alert was sent."
	sent: String
}

"A parameter of an alert with its values, such as NWSheadline or VTEC."
type NwsStringListEntry {
	"The key."
	key: String
	"The value of the key."
	value: [String]
}

"The link to the next page of a list."
type NwsPaginationInfo {
	"A link to the next page of records"
	next: String
}

"The weather alerts of the National Weather Service in force now."
type NwsActiveAlertCollection {
	type: String
	"The items of the list, each a GeoJSON feature with the item under properties."
	features: [NwsAlertFeature]
	"A title describing the alert collection"
	title: String
	"The last time a change occurred to this collection"
	updated: String
}

"How many weather alerts are in force now, in total and by area."
type NwsActiveAlertCounts {
	"The total number of active alerts"
	total: Int
	"The total number of active alerts affecting land zones"
	land: Int
	"The total number of active alerts affecting marine zones"
	marine: Int
	"The number of alerts in force by marine region."
	regions: [NwsIntEntry]
	"The number of alerts in force by state or marine area, such as CO for Colorado."
	areas: [NwsIntEntry]
	"The number of alerts in force by zone or county code."
	zones: [NwsIntEntry]
}

"A count with the code it counts for, such as the number of alerts in force for the area CO."
type NwsIntEntry {
	"The key."
	key: String
	"The value of the key."
	value: Int
}

"The names of the kinds of weather alert."
type NwsAlertTypes {
	"A list of recognized event types"
	eventTypes: [String]
}

"""
An office of the National Weather Service, such as a forecast office or a Center Weather Service Unit.
