"A measured or forecast value with its unit, such as 21.1 with the unit wmoUnit:degC."
type NwsQuantitativeValue {
	"A measured value"
	value: Float
	"The maximum value of a range of measured values"
	maxValue: Float
	"The minimum value of a range of measured values"
	minValue: Float
	"""
	The unit of the value, such as wmoUnit:degC for degrees Celsius, wmoUnit:km_h-1 for kilometres per hour or
	wmoUnit:percent.
	"""
	unitCode: String
	"""
	For values in observation records, the quality control flag from the MADIS system. The definitions of these
	flags can be found at https://madis.ncep.noaa.gov/madis_sfc_qc_notes.shtml
	"""
	qualityControl: String
}

"The forecast weather conditions of a gridpoint over time."
type NwsGridpointWeatherLayer {
	values: [NwsGridpointWeatherPeriod]
}

"The weather conditions forecast for one time interval."
type NwsGridpointWeatherPeriod {
	"""
	A time interval in ISO 8601 format. This can be one of:
	1. Start and end time
	2. Start time and duration
	3. Duration and end time
	The string "NOW" can also be used in place of a start/end time.
	"""
	validTime: String
	value: [NwsGridpointWeatherCondition]
}

"One forecast weather condition, such as a chance of light rain showers."
type NwsGridpointWeatherCondition {
	coverage: String
	weather: String
	intensity: String
	"""
	A structured value representing a measurement and its unit of measure. This object is a slightly modified
	version of the schema.org definition at https://schema.org/QuantitativeValue
	"""
	visibility: NwsQuantitativeValue
	attributes: [String]
}

"The watches, warnings and advisories that the forecast expects over time."
