"The ranks of the classification of living things, from kingdom down to form."
enum InatRank {
	stateofmatter
	kingdom
	phylum
	subphylum
	superclass
	class
	subclass
	superorder
	order
	suborder
	infraorder
	superfamily
	epifamily
	family
	subfamily
	supertribe
	tribe
	subtribe
	genus
	genushybrid
	species
	hybrid
	subspecies
	variety
	form
}

"The categories of the IUCN Red List, from least concern (LC) to extinct (EX)."
enum InatIucnStatus {
	LC
	NT
	VU
	EN
	CR
	EW
	EX
}

"The values iNaturalist accepts for one of its arguments."
enum InatGeoprivacy {
	obscured
	obscured_private
	open
	private
}

"The values iNaturalist accepts for one of its arguments."
enum InatObscuration {
	obscured
	private
	none
}

