	"The number of results on this page."
	per_page: Int
	results: [InatPopularFieldValue]
}

"The results of a popular field value page, as iNaturalist sends it."
type InatPopularFieldValue {
	count: Int
	month_of_year: [InatPeriodCountEntry]
