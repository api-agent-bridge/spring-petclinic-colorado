	controlled_value: InatControlledValue
}

"""
An annotation that iNaturalist members can add to an observation, such as life stage, with its allowed values.
"""
type InatControlledTerm {
	id: Int
	ontology_uri: String
	uri: String
	is_value: Boolean
	multivalued: Boolean
	uuid: String
	values: [InatControlledValue]
	taxon_ids: [Int]
	excepted_taxon_ids: [Int]
	label: String
}

"One allowed value of an annotation, such as Adult for life stage."
type InatControlledValue {
	id: Int
	ontology_uri: String
	uri: String
	blocking: Boolean
	uuid: String
	label: String
	taxon_ids: [Int]
	excepted_taxon_ids: [Int]
	is_value: Boolean
}

"The answer of inatIdentifications, as iNaturalist sends it."
type InatIdentificationPage {
	"The number of results across all pages."
	total_results: Int
	page: Int
	"The number of results on this page."
