	"""
	How many iNaturalist observations match a search in each month of the year, week of the year, hour, day, week or
	month, as counts keyed by that period. Use it for questions about seasons, such as "in which month are coyotes
	seen most in Colorado" (taxon_id 42051, place_id 34, interval month_of_year).
	Observation Histogram
	Given zero to many of following parameters, returns histogram data about observations matching the search
	criteria
	"""
	inatObservationHistogram(
		"Whether or not positional accuracy / coordinate uncertainty has been specified"
		acc: Boolean
		"Captive or cultivated observations"
		captive: Boolean
		"Observations whose taxa are endemic to their location"
		endemic: Boolean
