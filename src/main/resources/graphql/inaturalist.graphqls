	# The iNaturalist taxa: the species and the groups above them, with their common names.

	"""
	Species and higher groups of living things on iNaturalist whose scientific or common name matches a text, with
	their rank, their place in the classification and how often members observed them. Searching "coyote" finds
	Canis latrans, taxon_id 42051.
	Taxon Search
	Given zero to many of following parameters, returns taxa matching the search criteria
	"""
	inatTaxa(
		"The text to search for in the names, for example coyote."
		q: String
		"Taxon is active"
		is_active: Boolean
		"Comma-separated list of taxon IDs"
		id: [Int!]
		"Taxon's parent must have this ID"
		parent_id: Int
		"Taxon must have this rank"
		rank: [InatRank!]
		"""
		Taxon must have this rank level. Some example values are 70 (kingdom), 60 (phylum), 50 (class), 40 (order), 30
		(family), 20 (genus), 10 (species), 5 (subspecies)
		"""
		rank_level: Float
		"Must have an ID above this value"
		id_above: String
		"Must have an ID below this value"
		id_below: String
		"Locale preference for taxon common names"
		locale: String
		"Place preference for regional taxon common names"
		preferred_place_id: Int
		"Return only the record IDs"
		only_id: Boolean
		"Include all taxon names in the response"
		all_names: Boolean
		"Sort order"
		order: InatSortOrder
		"Sort field"
		order_by: InatTaxonOrderBy
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): InatTaxonPage

	"""
	One species or higher group on iNaturalist by its taxon id, or several with the ids separated by commas, with
	its common name, its classification, a Wikipedia summary, its photos and its conservation statuses. The domestic
	dog is 47144 and the domestic cat is 118552.
	Taxon Details
	Given an ID, or an array of IDs in comma-delimited format, returns corresponding taxa. A maximum of 30 results
	will be returned
	"""
	inatTaxon(
		"Must have this ID"
		id: ID!
		"""
		Taxon must have this rank level. Some example values are 70 (kingdom), 60 (phylum), 50 (class), 40 (order), 30
		(family), 20 (genus), 10 (species), 5 (subspecies)
		"""
		rank_level: Float
	): InatTaxonPage

	"""
	Species and higher groups on iNaturalist whose name starts with a text, best match first, to turn a name such as
	"dog" or "mule deer" into the taxon_id that the observation fields take.
	Taxon Autocomplete
	Given an string, returns taxa with names starting with the search term
	"""
	inatTaxonAutocomplete(
		"The text to search for, for example coyote or Denver."
		q: String
		"Taxon is active"
		is_active: Boolean
		"""
		Only these taxa and the taxa below them, by taxon id: 47144 for the domestic dog, 118552 for the domestic cat,
		42051 for the coyote. inatTaxonAutocomplete finds the id of a name.
		"""
		taxon_id: [String!]
		"Taxon must have this rank"
		rank: [InatRank!]
		"""
		Taxon must have this rank level. Some example values are 70 (kingdom), 60 (phylum), 50 (class), 40 (order), 30
		(family), 20 (genus), 10 (species), 5 (subspecies)
		"""
		rank_level: Float
		"Locale preference for taxon common names"
		locale: String
		"Place preference for regional taxon common names"
		preferred_place_id: Int
		"Include all taxon names in the response"
		all_names: Boolean
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): InatTaxonPage

	"""
	The annotations iNaturalist members can add to an observation, such as life stage, sex, or alive or dead, each
	with its allowed values and their ids.
	Terms Index
	List all attribute controlled terms
	"""
	inatControlledTerms: InatControlledTermPage

	"""
	The annotations iNaturalist offers for one taxon. It matches only the taxa that a term names itself, so animals
	(taxon_id 1) get alive or dead and life stage, while the domestic dog (47144) gets an empty list.
	Terms for Taxon
	Returns attribute controlled terms relevant to a taxon
	"""
	inatControlledTermsForTaxon(
		"""
		Only these taxa and the taxa below them, by taxon id: 47144 for the domestic dog, 118552 for the domestic cat,
		42051 for the coyote. inatTaxonAutocomplete finds the id of a name.
		"""
		taxon_id: Int
	): InatControlledTermPage

	# The iNaturalist places, such as Colorado (place_id 34) and Denver County (place_id 205).

	"""
	One iNaturalist place by its id, or several with the ids separated by commas, with its name, its type, its
	boundary as GeoJSON and the places it lies in. Colorado is 34 and Denver County is 205.
	Place Details
	Given an ID, or an array of IDs in comma-delimited format, returns corresponding places. A maximum of 500
	results will be returned
	"""
	inatPlace(
		"Must have this ID or slug"
		id: ID!
		"""
		Admin level of a place, or an array of admin levels in comma-delimited format. Supported admin levels are: -10
		(continent), 0 (country), 10 (state), 20 (county), 30 (town), 100 (park)
		"""
		admin_level: [String!]
	): InatPlacePage

	"""
	iNaturalist places whose name starts with a text, to turn a name such as "Denver" into the place_id that the
	observation fields take. The boundary of each place is large, so select only id and display_name unless the
	question needs the shape.
	Place Autocomplete
	Given an string, returns places with names starting with the search term.
	"""
	inatPlaceAutocomplete(
		"The text to search for, for example coyote or Denver."
		q: String
		"Sort field"
		order_by: InatPlaceOrderBy
	): InatPlacePage

	"""
	The iNaturalist places inside a box of latitudes and longitudes, split into standard places that curators
	approved and community places that members drew, such as parks and neighbourhoods around downtown Denver.
	Nearby Places
	Given an bounding box, and an optional name query, return standard iNaturalist curator approved and community
	non-curated places nearby
	"""
	inatPlacesNearby(
		"Must be nearby this bounding box (*nelat, *nelng, *swlat, *swlng)"
		nelat: Float
		"Must be nearby this bounding box (*nelat, *nelng, *swlat, *swlng)"
		nelng: Float
		"Must be nearby this bounding box (*nelat, *nelng, *swlat, *swlng)"
		swlat: Float
		"Must be nearby this bounding box (*nelat, *nelng, *swlat, *swlng)"
		swlng: Float
		"Name must match this value"
		name: String
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): InatNearbyPlaces

	# The iNaturalist projects, which collect observations for a place, a group of species or an event.

	"""
	iNaturalist projects whose title matches a text, near a point or in a place, such as the yearly City Nature
	Challenge for Denver and Boulder, with their description, place and rules.
	Project Search
	Given zero to many of following parameters, returns projects matching the search criteria
	"""
	inatProjects(
		"The text to search for, for example coyote or Denver."
		q: String
		"Must have this ID"
		id: [String!]
		"Must not have this ID"
		not_id: [String!]
		"Must be within a radius kilometer circle around this lat/lng (*lat, *lng, radius)"
		lat: Float
		"Must be within a radius kilometer circle around this lat/lng (*lat, *lng, radius)"
		lng: Float
		"""
		Only within these places, by place id: 34 for Colorado, 205 for Denver County. inatPlaceAutocomplete finds the
		id of a name.
		"""
		place_id: [String!]
		"""
		Must be within a radius kilometer circle around this lat/lng (*lat, *lng, radius). Defaults to 500km
		"""
		radius: String
		"Must be marked featured for the relevant site"
		featured: Boolean
		"Must be marked noteworthy for the relevant site"
		noteworthy: Boolean
		"""
		Site ID that applies to featured and noteworthy. Defaults to the site of the authenticated user, or to the main
		iNaturalist site https://www.inaturalist.org
		"""
		site_id: Int
		"""
		Return more information about project rules, for example return a full taxon object instead of simply an ID
		"""
		rule_details: Boolean
		"Projects must be of this type"
		type: [InatProjectSearchType!]
		"Project must have member with this user ID"
		member_id: Int
		"Must have search parameter requirements"
		has_params: Boolean
		"Must have posts"
		has_posts: Boolean
		"Sort field"
		order_by: InatProjectOrderBy
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): InatProjectPage

	"""
	One iNaturalist project by its id, or several with the ids separated by commas, with its description, its place
	and the rules an observation must meet to belong to it. Project 228057 collects the biodiversity of the City and
	County of Denver.
	Project Details
	Given an ID, or an array of IDs in comma-delimited format, returns corresponding projects. A maximum of 100
	results will be returned
	"""
	inatProject(
		"Must have this ID or slug"
		id: ID!
		"""
		Return more information about project rules, for example return a full taxon object instead of simply an ID
		"""
		rule_details: Boolean
	): InatProjectPage

	"""
	The members of one iNaturalist project, each with their role and the number of observations and species they
	contributed.
	Project Members
	Given an ID, return members of the project
	"""
	inatProjectMembers(
		"ID of the record"
		id: ID!
		"Membership role"
		role: InatRole
		"""
		If counts are not needed, consider setting this to true to save on processing time, resulting in faster
		responses
		"""
		skip_counts: Boolean
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): InatProjectMemberPage

	"""
	iNaturalist projects whose title starts with a text, to find the id of a project such as the Denver EcoFlora
	Project.
	Project Autocomplete
	Given an string, returns projects with titles starting with the search term
	"""
	inatProjectAutocomplete(
		"The text to search for, for example coyote or Denver."
		q: String
		"Must have this ID"
		id: [String!]
		"Must not have this ID"
		not_id: [String!]
		"Must be within a radius kilometer circle around this lat/lng (*lat, *lng, radius)"
		lat: Float
		"Must be within a radius kilometer circle around this lat/lng (*lat, *lng, radius)"
		lng: Float
		"""
		Only within these places, by place id: 34 for Colorado, 205 for Denver County. inatPlaceAutocomplete finds the
		id of a name.
		"""
		place_id: [String!]
		"""
		Must be within a radius kilometer circle around this lat/lng (*lat, *lng, radius). Defaults to 500km
		"""
		radius: String
		"Must be marked featured for the relevant site"
		featured: Boolean
		"Must be marked noteworthy for the relevant site"
		noteworthy: Boolean
		"""
		Site ID that applies to featured and noteworthy. Defaults to the site of the authenticated user, or to the main
		iNaturalist site https://www.inaturalist.org
		"""
		site_id: Int
		"""
		Return more information about project rules, for example return a full taxon object instead of simply an ID
		"""
		rule_details: Boolean
		"Projects must be of this type"
		type: [InatProjectSearchType!]
		"Project must have member with this user ID"
		member_id: Int
		"Must have search parameter requirements"
		has_params: Boolean
		"Must have posts"
		has_posts: Boolean
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): InatProjectPage

	"""
	One search across iNaturalist's taxa, places, projects and members by a text, best match first, with the kind of
	each result in type. Use it when the question names something and the kind is unclear.
	Site Search
	Given zero to many of following parameters, returns object matching the search criteria
	"""
	inatSearch(
		"The text to search for, for example coyote or Denver."
		q: String
		"Must be of this type"
		sources: [InatSearchSource!]
		"""
		Only within these places, by place id: 34 for Colorado, 205 for Denver County. inatPlaceAutocomplete finds the
		id of a name.
		"""
		place_id: [String!]
		"Include taxon ancestors in the response"
		include_taxon_ancestors: Boolean
		"Locale preference for taxon common names"
		locale: String
		"Place preference for regional taxon common names"
		preferred_place_id: Int
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): InatSearchResultPage

	# The iNaturalist members and their journal posts. Members choose a login and may add a name.

	"""
	One iNaturalist member by their id, with their login and the numbers of their observations, identifications and
	species.
	User Details
	Given an ID, returns corresponding user
	"""
	inatUser(
		"ID of the record"
		id: ID!
	): InatUserPage

	"""
	The iNaturalist projects that one member joined.
	User Projects
	Return projects as user has joined / followed
	"""
	inatUserProjects(
		"ID of the record"
		id: ID!
		"""
		Return more information about project rules, for example return a full taxon object instead of simply an ID
		"""
		rule_details: Boolean
		"Specify the type of project to return"
		project_type: InatProjectType
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): InatProjectPage

	"""
	iNaturalist members whose login or name starts with a text, to find the id of a member.
	User Autocomplete
	Given an string, returns users with names or logins starting with the search term
	"""
	inatUserAutocomplete(
		"The text to search for, for example coyote or Denver."
		q: String
		"Only show users with memberships to this project"
		project_id: Int
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): InatUserPage

	"""
	Journal posts on iNaturalist, written by a member or for a project, newest first, such as the news of the Denver
	EcoFlora Project (project_id 66408). Without a member or a project it answers the news of the iNaturalist site.
	Posts Search
	Return journal posts from the iNaturalist site
	"""
	inatPosts(
		"Return posts by this user"
		login: String
		"Return posts from this project"
		project_id: Int
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): [InatPost]
}

"One page of iNaturalist observations, with the number of matches across all pages in total_results."
type InatObservationPage {
	"The number of results across all pages."
	total_results: Int
	page: Int
	"The number of results on this page."
	per_page: Int
	results: [InatObservation]
}

"""
A sighting that an iNaturalist member recorded: what they saw, where, when, with photos or sounds, and the
identifications other members added. The species the community agreed on is in taxon, and quality_grade is
research once the community confirmed it.
"""
type InatObservation {
	annotations: [InatAnnotation]
	id: Int
	cached_votes_total: Int
	"Whether the organism was captive or cultivated, as a pet or a garden plant is."
	captive: Boolean
	comments: [InatComment]
	comments_count: Int
	created_at: String
	created_at_details: InatDateDetails
	created_time_zone: String
	description: String
	faves_count: Int
	geojson: InatPoint
	"obscured or private when the observer hid the exact location."
	geoprivacy: String
	"""
	obscured when the species is threatened and iNaturalist hides the exact location of every observation of it.
	"""
	taxon_geoprivacy: String
	id_please: Boolean
	identifications_count: Int
	identifications_most_agree: Boolean
	identifications_most_disagree: Boolean
	identifications_some_agree: Boolean
	license_code: String
	"""
	The latitude and longitude, as "lat,lng".
	"""
	location: String
	"""
	in the format "lat,lng"
	"""
	private_location: String
	mappable: Boolean
	non_owner_ids: [InatIdentification]
	num_identification_agreements: Int
	num_identification_disagreements: Int
	"Whether the coordinates were moved to a random point near the real one."
	obscured: Boolean
	"The day of the sighting, as YYYY-MM-DD."
	observed_on: String
	observed_on_details: InatDateDetails
	observed_on_string: String
	observed_time_zone: String
	ofvs: [InatObservationFieldValue]
	out_of_range: Boolean
	photos: [InatPhoto]
	"The place as the observer's device or the observer described it."
	place_guess: String
	private_place_guess: String
	place_ids: [Int]
	private_place_ids: [Int]
	positional_accuracy: Int
	private_geojson: InatPoint
	project_ids: [Int]
	project_ids_with_curator_id: [Int]
	project_ids_without_curator_id: [Int]
	public_positional_accuracy: Int
	"casual, needs_id, or research when the community agreed on the species."
	quality_grade: String
	reviewed_by: [Int]
	site_id: Int
	sounds: [InatSound]
	"The name the observer gave when they recorded the observation."
	species_guess: String
	tags: [String]
	taxon: InatTaxon
	time_observed_at: String
	time_zone_offset: String
	updated_at: String
	uri: String
	user: InatUser
	uuid: String
	verifiable: Boolean
	observation_photos: [InatObservationPhoto]
	quality_metrics: [InatQualityMetric]
	flags: [InatFlag]
	community_taxon_id: Int
	faves: [InatFave]
	identifications: [InatIdentification]
	oauth_application_id: Int
	outlinks: [InatOutlink]
	owners_identification_from_vision: Boolean
	project_observations: [InatProjectObservation]
	spam: Boolean
	votes: [InatVote]
	identification_disagreements_count: Int
	ident_taxon_ids: [Int]
	map_scale: Int
	application: InatObservationApplication
	community_taxon: InatTaxon
	user_id: Int
}

"The annotations of an observation, as iNaturalist sends it."
type InatAnnotation {
	uuid: String
	controlled_attribute_id: Int
	controlled_value_id: Int
	concatenated_attr_val: String
	user: InatUser
	user_id: Int
	vote_score: Int
	votes: [InatVote]
}

"An iNaturalist member, with the numbers of their observations, identifications and species."
type InatUser {
	created_at: String
	id: Int
	icon: String
	icon_url: String
	identifications_count: Int
	journal_posts_count: Int
	login: String
	name: String
	observations_count: Int
	orcid: String
	roles: [String]
	site_id: Int
	species_count: Int
	spam: Boolean
	suspended: Boolean
	login_autocomplete: String
	login_exact: String
	name_autocomplete: String
	activity_count: Int
	annotated_observations_count: Int
	universal_search_rank: Int
	user_icon_url: String
	medium_user_icon_url: String
}

"The votes of an annotation, as iNaturalist sends it."
type InatVote {
	id: Int
	user_id: Int
	vote_flag: Boolean
	vote_scope: String
	created_at: String
}

"The comments of an observation, as iNaturalist sends it."
type InatComment {
	id: Int
	body: String
	created_at: String
	created_at_details: InatDateDetails
	user: InatUser
	flags: [InatFlag]
	hidden: Boolean
	moderator_actions: [InatModeratorAction]
	uuid: String
}

"A date split into its parts, as iNaturalist sends it with each observation."
type InatDateDetails {
	date: String
	day: Int
	hour: Int
	month: Int
	week: Int
	year: Int
}

"The flags of a comment, as iNaturalist sends it."
type InatFlag {
	id: Int
	flag: String
	comment: String
	resolved: Boolean
	user: InatUser
	created_at: String
	user_id: Int
	resolver_id: Int
	updated_at: String
}

"The moderator actions of a comment, as iNaturalist sends it."
type InatModeratorAction {
	id: Int
	created_at: String
	created_at_details: InatDateDetails
	user: InatUser
	action: String
	reason: String
}

"A point as GeoJSON, with coordinates as longitude then latitude."
type InatPoint {
	type: String
	"an array of [long, lat]"
	coordinates: [Float]
}

"""
The taxon one iNaturalist member named for an observation, with when and how it relates to the identifications
of other members.
"""
type InatIdentification {
	id: Int
	body: String
	created_at: String
	created_at_details: InatDateDetails
	user: InatUser
	uuid: String
	category: String
	current: Boolean
	own_observation: Boolean
	vision: Boolean
	disagreement: Boolean
	previous_observation_taxon_id: Int
	spam: Boolean
	taxon_id: Int
	hidden: Boolean
	exemplar_identification: InatExemplarIdentification
	taxon: InatTaxon
	previous_observation_taxon: InatTaxon
	observation_id: Int
	updated_at: String
	flags: [InatFlag]
	taxon_change: InatIdentificationTaxonChange
	moderator_actions: [InatModeratorAction]
	current_taxon: Boolean
	observation: InatObservation
}

"The exemplar identification of an identification, as iNaturalist sends it."
type InatExemplarIdentification {
	id: Int
	created_at: String
	cached_votes_total: Int
	active: Boolean
}

"""
A species or a higher group of living things on iNaturalist, such as Canis familiaris, the domestic dog, with
its rank, its common name, its place in the classification and how often members observed it.
"""
type InatTaxon {
	id: Int
	rank: String
	rank_level: Float
	iconic_taxon_id: Int
	ancestor_ids: [Int]
	is_active: Boolean
	min_species_taxon_id: Int
	"The scientific name, for example Canis familiaris."
	name: String
	parent_id: Int
	ancestry: String
	min_species_ancestry: String
	extinct: Boolean
	provisional: Boolean
	created_at: String
	default_photo: InatPhoto
	taxon_changes_count: Int
	taxon_schemes_count: Int
	"The number of observations of this taxon on iNaturalist, worldwide."
	observations_count: Int
	photos_locked: Boolean
	universal_search_rank: Int
	flag_counts: InatFlagCounts
	atlas_id: Int
	wikipedia_url: String
	iconic_taxon_name: String
	"The common name in English, for example Domestic Dog."
	preferred_common_name: String
	establishment_means: InatEstablishmentMeans
	preferred_establishment_means: String
	complete_species_count: Int
	complete_rank: String
	ancestors: [InatTaxon]
	conservation_status: InatConservationStatus
	endemic: Boolean
	introduced: Boolean
	native: Boolean
	threatened: Boolean
	"The first lines of the taxon's Wikipedia article."
	wikipedia_summary: String
	colors: [InatColor]
	conservation_statuses: [InatConservationStatus]
	names: [InatTaxonName]
	place_ids: [Int]
	listed_taxa: [InatListedTaxon]
	taxon_photos: [InatTaxonPhoto]
	matched_term: String
	children: [InatTaxon]
	listed_taxa_count: Int
	vision: Boolean
}

"""
A photo on iNaturalist, with its license and the attribution to show with it. The url points at a small version:
replace square in it with small, medium, large or original for another size.
"""
type InatPhoto {
	id: Int
	license_code: String
	attribution: String
	url: String
	original_dimensions: InatPhotoDimensions
	attribution_name: String
	square_url: String
	medium_url: String
	hidden: Boolean
	flags: [InatFlag]
	native_page_url: String
	native_photo_id: String
	type: String
	small_url: String
	large_url: String
	original_url: String
}

"The original dimensions of a photo, as iNaturalist sends it."
type InatPhotoDimensions {
	height: Int
	width: Int
}

"The flag counts of a taxon, as iNaturalist sends it."
type InatFlagCounts {
	resolved: Int
	unresolved: Int
}

"The establishment means of a taxon, as iNaturalist sends it."
type InatEstablishmentMeans {
	id: Int
	place_id: Int
	establishment_means: String
	place: InatPlace
	occurrence_status_level: Int
}

"A place on iNaturalist, such as a state, a county, a city or a park, with its boundary."
type InatPlace {
	id: Int
	name: String
	display_name: String
	ancestry: String
	place_type_name: String
	admin_level: Int
	ancestor_place_ids: [Int]
	bbox_area: Float
	geometry_geojson: InatGeometry
	"""
	in the format "lat,lng"
	"""
	location: String
	place_type: Int
	uuid: String
	slug: String
	bounding_box_geojson: InatBoundingBox
}

"The ofvs of an observation, as iNaturalist sends it."
type InatObservationFieldValue {
	name: String
	value: String
}

"The sounds of an observation, as iNaturalist sends it."
type InatSound {
	id: Int
	attribution: String
	license_code: String
	file_url: String
	file_content_type: String
	flags: [InatFlag]
	hidden: Boolean
	moderator_actions: [InatModeratorAction]
}

"""
How threatened a species is in a place, according to an authority such as NatureServe or the IUCN Red List.
"""
type InatConservationStatus {
	"""
	Identifier for the iNat source record associated with this status, retrievable via
	https://www.inaturalist.org/sources/:id.json (this endpoint is not a part of our public API and is thus subject
	to change or removal)
	"""
	source_id: Int
	"Organization that declared this status"
	authority: String
	"""
	Body of the status, often coded, particularly when the status comes from the IUCN or NatureServe. Consult the
	authority and/or the status URL for details about the meanings of codes.
	"""
	status: String
	"Human-readable name of the status if it was coded."
	status_name: String
	"""
	Coded value representing the equivalent IUCN status. Mappings: NOT_EVALUATED = 0, DATA_DEFICIENT = 5,
	LEAST_CONCERN = 10, NEAR_THREATENED = 20, VULNERABLE = 30, ENDANGERED = 40, CRITICALLY_ENDANGERED = 50,
	EXTINCT_IN_THE_WILD = 60, EXTINCT = 70
	"""
	iucn: Int
	"Default geoprivacy for observations of this taxon in the status's place."
	geoprivacy: String
	place_id: Int
	place: InatPlace
	id: Int
	user_id: Int
}

"The observation photos of an observation, as iNaturalist sends it."
type InatObservationPhoto {
	id: Int
	uuid: String
	photo: InatPhoto
	position: Int
	photo_id: Int
}

"The quality metrics of an observation, as iNaturalist sends it."
type InatQualityMetric {
	id: Int
	user_id: Int
	metric: String
	agree: Boolean
	user: InatUser
}

"The faves of an observation, as iNaturalist sends it."
type InatFave {
	id: Int
	votable_id: Int
	created_at: String
	user: InatUser
}

"The taxon change of an identification, as iNaturalist sends it."
type InatIdentificationTaxonChange {
	id: Int
	type: String
}

"The outlinks of an observation, as iNaturalist sends it."
type InatOutlink {
	id: Int
	source: String
	url: String
}

"The project observations of an observation, as iNaturalist sends it."
type InatProjectObservation {
	id: Int
	project_id: Int
	observation_id: Int
	curator_identification_id: Int
	tracking_code: String
	prefers_curator_coordinate_access: Boolean
	uuid: String
	project: InatProject
	user_id: Int
	preferences: InatProjectObservationPreferences
	user: InatUser
}

"The application of an observation, as iNaturalist sends it."
type InatObservationApplication {
	id: Int
	name: String
	url: String
	icon: String
}

"What iNaturalist knows about the species of an observation at the place where it was made."
type InatObservationTaxonSummary {
	listed_taxon: InatListedTaxon
	wikipedia_summary: String
}

"A species on the checklist of a place, with whether it is native, introduced or endemic there."
type InatListedTaxon {
	id: Int
