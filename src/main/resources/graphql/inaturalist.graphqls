	list_id: Int
	last_observation_id: Int
	created_at: String
	updated_at: String
	place_id: Int
	comments_count: Int
	establishment_means: String
	first_observation_id: Int
	observations_count: Int
	manually_added: Boolean
	primary_listing: Boolean
	establishment_means_label: String
	establishment_means_description: String
	place: InatPlace
	occurrence_status_level: Int
	list: InatTaxonList
}

"The answer of inatObservationSpeciesCounts, as iNaturalist sends it."
type InatSpeciesCountPage {
	"The number of results across all pages."
	total_results: Int
	page: Int
	"The number of results on this page."
	per_page: Int
	results: [InatSpeciesCount]
