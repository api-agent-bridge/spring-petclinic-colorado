	value: String
}

"""
Counts of iNaturalist observations per period, keyed by the period: the month from 1 to 12, the week, the hour,
or a date.
"""
type InatObservationHistogram {
	"The number of results across all pages."
	total_results: Int
	page: Int
	"The number of results on this page."
	per_page: Int
	results: InatHistogramPeriods
}

"""
The counts of an iNaturalist histogram, under the name of the interval that was asked for. Each entry has the
period as its key and the number of observations as its value.
"""
type InatHistogramPeriods {
	month_of_year: [InatPeriodCountEntry]
	year: [InatPeriodCountEntry]
	month: [InatPeriodCountEntry]
	week: [InatPeriodCountEntry]
	day: [InatPeriodCountEntry]
	hour: [InatPeriodCountEntry]
	week_of_year: [InatPeriodCountEntry]
}

"""
The number of observations in one period: the key is the period, such as 4 for April with month_of_year or
2026-09-01 with month, and the value is the count.
"""
type InatPeriodCountEntry {
	"The key."
	key: String
	"The value."
	value: Int
}

"The answer of inatObservationObservers, as iNaturalist sends it."
type InatObserverCountPage {
	"The number of results across all pages."
	total_results: Int
	page: Int
	"The number of results on this page."
	per_page: Int
	results: [InatObserverCount]
}

"""
An iNaturalist member with the numbers of observations and of distinct species they recorded among those that
match a search.
"""
type InatObserverCount {
	observation_count: Int
	species_count: Int
	user: InatUser
	user_id: Int
}

"The answer of inatObservationIdentifiers, as iNaturalist sends it."
type InatUserCountPage {
	"The number of results across all pages."
	total_results: Int
	page: Int
	"The number of results on this page."
	per_page: Int
	results: [InatUserCount]
}

"An iNaturalist member with the number of observations or identifications that match a search."
type InatUserCount {
	count: Int
	user: InatUser
	user_id: Int
}

"The answer of inatObservationPopularFieldValues, as iNaturalist sends it."
type InatPopularFieldValuePage {
	"The number of results across all pages."
