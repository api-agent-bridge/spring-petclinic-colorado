# iNaturalist (https://api.inaturalist.org/v1/docs/), the community science platform for sightings of animals,
# plants and fungi. The fields and types below are generated from its Swagger document and from answers recorded
# from the live API, with hand-written descriptions. Each field is one GET operation, and RestOperationFetcher
# calls it with the operation table in inaturalist/operations.json.

extend type Query {
	# The iNaturalist observations: who saw which animal or plant, where and when.

	"""
	Sightings of animals, plants and fungi that iNaturalist members recorded with a photo or a sound at a place and
	a time, for example the domestic dogs observed in Denver County (taxon_id 47144, place_id 205) or the coyotes
	seen in Colorado (taxon_id 42051, place_id 34). Each observation names the species the community agreed on, the
	date, the place and the photos, and its quality_grade is research when the community confirmed the species. A
	pet is captive, so observations of dogs and cats stay casual.
	An observation with every field is 15,000 to 30,000 tokens, because it carries every identification with the
	full classification. Narrow the search with taxon_id, place_id, d1 and d2, and select only the fields the
	question needs. To count observations, select only total_results with size 1. For the species seen at a place,
	inatObservationSpeciesCounts answers in one call.
	"""
	inatObservations(
		"Whether or not positional accuracy / coordinate uncertainty has been specified"
		acc: Boolean
		"Captive or cultivated observations"
		captive: Boolean
		"Observations whose taxa are endemic to their location"
		endemic: Boolean
		"Observations that are georeferenced"
		geo: Boolean
		"""
		Observations with the deprecated ID, Please! flag. Note that this will return observations, but that this
		attribute is no longer used.
		"""
		id_please: Boolean
		"Observations that have community identifications"
		identified: Boolean
		"Observations whose taxa are introduced in their location"
		introduced: Boolean
		"Observations that show on map tiles"
		mappable: Boolean
		"Observations whose taxa are native to their location"
		native: Boolean
		"Observations whose taxa are outside their known ranges"
		out_of_range: Boolean
		"""
		Observations identified by the curator of a project. If the project_id parameter is also specified, this will
		only consider observations identified by curators of the specified project(s)
		"""
		pcid: Boolean
		"Observations with photos"
		photos: Boolean
		"Observations that have been favorited by at least one user"
		popular: Boolean
		"Observations with sounds"
		sounds: Boolean
		"Observations of active taxon concepts"
		taxon_is_active: Boolean
		"Observations whose taxa are threatened in their location"
		threatened: Boolean
		"""
		Observations with a quality_grade of either needs_id or research. Equivalent to quality_grade=needs_id,research
		"""
		verifiable: Boolean
		"License attribute of an observation must not be null"
		licensed: Boolean
		"License attribute of at least one photo of an observation must not be null"
		photo_licensed: Boolean
		"Observation taxon is expected nearby"
		expected_nearby: Boolean
		"Must have this ID"
		id: [String!]
		"Must not have this ID"
		not_id: [String!]
		"Observation must have this license"
		license: [String!]
		"Must have an observation field value with this datatype"
		ofv_datatype: [String!]
		"Must have at least one photo with this license"
		photo_license: [String!]
		"""
		Only within these places, by place id: 34 for Colorado, 205 for Denver County. inatPlaceAutocomplete finds the
		id of a name.
		"""
		place_id: [Int!]
		"Must be added to the project this ID or slug"
		project_id: [String!]
		"Taxon must have this rank"
		rank: [InatRank!]
		"Must be affiliated with the iNaturalist network website with this ID"
		site_id: [String!]
		"Must have at least one sound with this license"
		sound_license: [String!]
		"""
		Only these taxa and the taxa below them, by taxon id: 47144 for the domestic dog, 118552 for the domestic cat,
		42051 for the coyote. inatTaxonAutocomplete finds the id of a name.
		"""
		taxon_id: [String!]
		"Exclude observations of these taxa and their descendants"
		without_taxon_id: [String!]
		"Taxon must have a scientific or common name matching this string"
		taxon_name: [String!]
		"User must have this ID or login"
		user_id: [String!]
		"User must have this login"
		user_login: [String!]
		"Observations identified by a particular user"
		ident_user_id: Int
		"Must be observed within this hour of the day"
		hour: [String!]
		"Must be observed within this day of the month"
		day: [String!]
		"Must be observed within this month"
		month: [String!]
		"Must be observed within this year"
		year: [String!]
		"Must be created within this day of the month"
		created_day: [String!]
		"Must be created within this month"
		created_month: [String!]
		"Must be created within this year"
		created_year: [String!]
		"Must have an annotation using this controlled term ID"
		term_id: [Int!]
		"Must have an annotation using this controlled value ID. Must be combined with the term_id parameter"
		term_value_id: [Int!]
		"Exclude observations with annotations using this controlled value ID."
		without_term_id: Int
		"""
		Exclude observations with annotations using this controlled value ID. Must be combined with the term_id
		parameter
		"""
		without_term_value_id: [Int!]
		"""
		Must be combined with the term_value_id or the without_term_value_id parameter. Must have an annotation using
		this controlled term ID and associated term value IDs or be missing this annotation.
		"""
		term_id_or_unknown: [Int!]
		"Must have an annotation created by this user"
		annotation_user_id: [String!]
		"Must have a positional accuracy above this value (meters)"
		acc_above: String
		"Must have a positional accuracy below this value (meters)"
		acc_below: String
		"Positional accuracy must be below this value (in meters) or be unknown"
		acc_below_or_unknown: String
		"Only observations made on or after this day, as YYYY-MM-DD."
		d1: String
		"Only observations made on or before this day, as YYYY-MM-DD."
		d2: String
		"Must be created at or after this time"
		created_d1: String
		"Must be created at or before this time"
		created_d2: String
		"Must be created on this date"
		created_on: String
		"Must be observed on this date"
		observed_on: String
		"Must not be of a taxon previously observed by this user"
		unobserved_by_user_id: Int
		"Must match the rules of the project with this ID or slug"
		apply_project_rules_for: String
		"""
		Taxon must have this conservation status code. If the place_id parameter is also specified, this will only
		consider statuses specific to that place
		"""
		cs: String
		"""
		Taxon must have a conservation status from this authority. If the place_id parameter is also specified, this
		will only consider statuses specific to that place
		"""
		csa: String
		"""
		Taxon must have this IUCN conservation status. If the place_id parameter is also specified, this will only
		consider statuses specific to that place
		"""
		csi: [InatIucnStatus!]
		"Must have this geoprivacy setting"
		geoprivacy: [InatGeoprivacy!]
		"""
		Filter observations by the most conservative geoprivacy applied by a conservation status associated with one of
		the taxa proposed in the current identifications.
		"""
		taxon_geoprivacy: [InatGeoprivacy!]
		"Must have geoprivacy or taxon_geoprivacy fields matching these values"
		obscuration: [InatObscuration!]
		"Taxon must have this rank or lower"
		hrank: InatRank
		"Taxon must have this rank or higher"
		lrank: InatRank
		"Taxon must by within this iconic taxon"
		iconic_taxa: [InatIconicTaxon!]
		"Must have an ID above this value"
		id_above: String
		"Must have an ID below this value"
		id_below: String
		"Identifications must meet these criteria"
		identifications: InatIdentificationAgreement
		"Must be within a radius kilometer circle around this lat/lng (*lat, *lng, radius)"
		lat: Float
		"Must be within a radius kilometer circle around this lat/lng (*lat, *lng, radius)"
		lng: Float
		"Must be within a radius kilometer circle around this lat/lng (*lat, *lng, radius)"
		radius: String
		"Must be within this bounding box (*nelat, *nelng, *swlat, *swlng)"
		nelat: Float
		"Must be within this bounding box (*nelat, *nelng, *swlat, *swlng)"
		nelng: Float
		"Must be within this bounding box (*nelat, *nelng, *swlat, *swlng)"
		swlat: Float
		"Must be within this bounding box (*nelat, *nelng, *swlat, *swlng)"
		swlng: Float
		"Taxon must be in the list with this ID"
		list_id: Int
		"Must not be in the project with this ID or slug"
		not_in_project: String
		"Must not match the rules of the project with this ID or slug"
		not_matching_project_rules_for: String
		"Must included in this observation accuracy experiment"
		observation_accuracy_experiment_id: [Int!]
		"Must be voted as not accurately depicting an organism or scene"
		fails_dqa_accurate: Boolean
		"Must be voted as not having an accurate date"
		fails_dqa_date: Boolean
		"Must be voted as not evidence of an organism"
		fails_dqa_evidence: Boolean
		"Must be voted as not having an accurate location"
		fails_dqa_location: Boolean
		"Must be voted as the community ID cannot be improved"
		fails_dqa_needs_id: Boolean
		"Must be voted as not recent evidence of an organism"
		fails_dqa_recent: Boolean
		"Must be voted as not having evidence related to a single subject"
		fails_dqa_subject: Boolean
		"Must be voted as not wild"
		fails_dqa_wild: Boolean
		"The text to search for, for example coyote or Denver."
		q: String
		"Properties to search on, when combined with q. Searches across all properties by default"
		search_on: InatSearchOn
		"Must have this quality grade"
		quality_grade: InatQualityGrade
		"Must be updated since this time"
		updated_since: String
		"See reviewed"
		viewer_id: String
		"Observations have been reviewed by the user with ID equal to the value of the viewer_id parameter"
		reviewed: Boolean
		"Locale preference for taxon common names"
		locale: String
		"Place preference for regional taxon common names"
		preferred_place_id: Int
		"""
		Set the Cache-Control HTTP header with this value as max-age, in seconds. This means subsequent identical
		requests will be cached on iNaturalist servers, and commonly within web browsers
		"""
		ttl: String
		"Sort order"
		order: InatSortOrder
		"Sort field"
		order_by: InatObservationOrderBy
		"Return only the record IDs"
		only_id: Boolean
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): InatObservationPage

	"""
	One iNaturalist observation by its id, or several with the ids separated by commas, with every detail: the
	identifications members added, the photos, the comments, the place and the date.
	Observation Details
	Given an ID, or an array of IDs in comma-delimited format, returns corresponding observations. A maximum of 200
	results will be returned
	"""
	inatObservation(
		"Must have this ID"
		id: ID!
	): InatObservationPage

	"""
	What iNaturalist knows about the species of one observation at the place where it was made: whether the species
	is native or introduced there, its conservation status there, and a short summary from Wikipedia. For
	observation 400469344, a domestic dog in Denver County, the species is introduced.
	Observation Taxon Summary
	Fetches information about this observation's taxon, within the context of this observation's location
	"""
	inatObservationTaxonSummary(
		"ID of the record"
		id: ID!
	): InatObservationTaxonSummary

	"""
	Which species people see most often in a place, from the sightings that iNaturalist members photograph and
	share: each species with the number of its observations, most observed first, for any search of observations. Use it for questions such as "which mammals are seen most often in Denver
	County" (place_id 205, iconic_taxa Mammalia) or "which birds were seen in Colorado this year".
	Observation Species Counts
	Given zero to many of following parameters, returns leaf taxa associated with observations matching the search
	criteria and the count of observations they are associated with, ordered by count descending. Leaf taxa are the
	leaves of the taxonomic tree containing only the taxa associated with observations matching the search criteria.
	"""
	inatObservationSpeciesCounts(
		"Whether or not positional accuracy / coordinate uncertainty has been specified"
		acc: Boolean
		"Captive or cultivated observations"
		captive: Boolean
		"Observations whose taxa are endemic to their location"
