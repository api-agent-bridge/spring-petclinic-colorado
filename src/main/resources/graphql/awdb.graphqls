}

"One reading of a station, with its date and, when asked for, its 30-year median and average."
type AwdbDataValue {
	"The timestamp of the data. Used only for DAILY and HOURLY durations."
	date: String
	"The month of the data value (1-12). Used only for MONTHLY and SEMIMONTHLY durations."
	month: Int
	"""
	The half of month of the data value ('1' for first half, '2' for second half). Used only for SEMIMONTHLY
	durations.
	"""
	monthPart: String
	"""
	The year of the data value. Used only for WATER_YEAR, CALENDAR_YEAR, MONTHLY, and SEMIMONTHLY durations.
	"""
	year: Int
	"The date the data value was collected. Used only for SEMIMONTHLY durations."
	collectionDate: String
	"The data value"
	value: Float
	"The qc flag of the data value"
	qcFlag: String
	"The qa flag of the data value"
	qaFlag: String
	"The original data value"
	origValue: Float
	"The original qc flag of the data value"
	origQcFlag: String
	"The 30-year average"
	average: Float
	"The 30-year median"
	median: Float
}

"The values that the service accepts for durationName."
enum AwdbDurationName {
	DAILY
	HOURLY
	SEMIMONTHLY
	MONTHLY
	CALENDAR_YEAR
	WATER_YEAR
}

"The values that the service accepts for periodReference."
enum AwdbPeriodReference {
	START
	END
}

"The values that the service accepts for centralTendency."
enum AwdbCentralTendency {
	NONE
	ALL
	MEDIAN
	AVERAGE
}
