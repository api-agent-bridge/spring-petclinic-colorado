	stationTriplet: String
	"The name of the forecast point."
	forecastPointName: String
	"Contains forecast data for a forecast point."
	data: [AwdbForecastValue]
}

"One water supply forecast for a period, with a value for each exceedance probability."
type AwdbForecastValue {
	"The element code related to the forecast record."
	elementCode: String
	"The start (MM-DD) and end (MM-DD) of the forecast period that the forecast is for."
	forecastPeriod: [String]
	"Indicates the status of the Forecast."
	forecastStatus: String
	"The issue date of the forecast."
	issueDate: String
	"The forecast period normal."
	periodNormal: Float
	"The publication date of the forecast value."
	publicationDate: String
	"The unit code of a forecast."
	unitCode: String
	"The forecast values keyed by exceedance probability in percent, such as 10, 30, 50, 70 and 90."
	forecastValues: [AwdbFloatEntry]
}

"""
A forecast value with its exceedance probability: the key 50 holds the value with a 50 percent chance of being
exceeded.
"""
type AwdbFloatEntry {
	"The key."
	key: String
	"The value of the key."
	value: Float
}

