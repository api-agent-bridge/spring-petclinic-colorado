type AwdbStationElement {
	"The element code"
	elementCode: String
	"The ordinal of the station element"
	ordinal: Int
	"The height/depth of the station element in inches"
	heightDepth: Int
	"The duration name of the station element"
	durationName: String
	"The data precision of the data for the station element"
	dataPrecision: Int
	"The units that the data is stored in"
	storedUnitCode: String
	"The units that the data was collected in"
	originalUnitCode: String
	"The date that the station element was put into service"
	beginDate: String
	"The date that the station element was taken out of service or 2100-01-01 if still in service"
	endDate: String
	"true/false if the station element data is derived"
	derivedData: Boolean
}

