# The National Park Service API (https://www.nps.gov/subjects/developer/api-documentation.htm), with data about
# the national parks, monuments and historic sites of the United States. The fields and types below are generated
# from its Swagger document and from answers recorded from the live API, with hand-written descriptions. Each
# field is one GET operation, and RestOperationFetcher calls it with the operation table in nps/operations.json.
# Every call needs a key from api.data.gov.

extend type Query {
	# The parks themselves, and what happens in them right now.

	"""
	The national parks, monuments and historic sites of the National Park Service in the United States, with their
	description, location, opening hours, entrance fees, contacts, activities and photos. Colorado has 17 sites,
	among them Rocky Mountain National Park (romo), Great Sand Dunes (grsa), Mesa Verde (meve) and Black Canyon of
	the Gunnison (blca). A park with every field is about 2,300 tokens, so narrow the list with parkCode or
	stateCode and select only the fields the question needs.
	Returns information about National Park Service parks and sites, with optional filters for park codes, state
	codes, or a search term.
	"""
	npsParks(
		"""
		One park code, or several separated by commas: romo for Rocky Mountain National Park, grsa for Great Sand Dunes,
		meve for Mesa Verde, blca for Black Canyon of the Gunnison. npsParks with stateCode CO lists the codes of every
		site in Colorado.
		"""
		parkCode: String
		"One two-letter state code, or several separated by commas, for example CO for Colorado."
		stateCode: String
		"A text to search for in the records, for example elk."
		q: String
		"""
		The fields to sort by, separated by commas. A field starting with a minus sign sorts in descending order, for
		example -relevanceScore.
		"""
		sort: String
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): NpsParkPage

	"""
	Notices that national park staff post about their park: closures of roads, trails and campgrounds, dangers such
	as toxic algae or fire restrictions, and visitor information, each in the category Park Closure, Danger, Caution
	or Information, for example the alerts of the national parks in Colorado (stateCode CO). Park staff write them;
	weather watches and warnings come from the National Weather Service.
	Returns park alerts, with optional filters for park codes, state codes, or a search term.
	"""
	npsAlerts(
		"""
		One park code, or several separated by commas: romo for Rocky Mountain National Park, grsa for Great Sand Dunes,
		meve for Mesa Verde, blca for Black Canyon of the Gunnison. npsParks with stateCode CO lists the codes of every
		site in Colorado.
		"""
		parkCode: String
		"One two-letter state code, or several separated by commas, for example CO for Colorado."
		stateCode: String
		"A text to search for in the records, for example elk."
		q: String
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): NpsAlertPage

	"""
	Incidents and work zones on the roads of a national park, as a GeoJSON feed in the Work Zone Data Exchange
	format. A park without current road events answers an empty list of features.
	Returns road events, optionally filtered by park code and event type.
	"""
	npsRoadEvents(
		"""
		One park code, or several separated by commas: romo for Rocky Mountain National Park, grsa for Great Sand Dunes,
		meve for Mesa Verde, blca for Black Canyon of the Gunnison. npsParks with stateCode CO lists the codes of every
		site in Colorado.
		"""
		parkCode: String
		"incident or workzone. Leave it out for both."
		type: String
	): NpsRoadEventFeed

	"""
	The webcams of national parks, with what each one shows, whether it streams video or shows still images, and the
	link to watch it, for example the views of Longs Peak and the Continental Divide in Rocky Mountain National Park
	(parkCode romo).
	Returns metadata for National Park Service webcams, with optional filters for park codes, state codes, webcam
	IDs, or a search term.
	"""
	npsWebcams(
		"""
		One park code, or several separated by commas: romo for Rocky Mountain National Park, grsa for Great Sand Dunes,
		meve for Mesa Verde, blca for Black Canyon of the Gunnison. npsParks with stateCode CO lists the codes of every
		site in Colorado.
		"""
		parkCode: String
		"One two-letter state code, or several separated by commas, for example CO for Colorado."
		stateCode: String
		"A comma delimited list of webcam IDs."
		id: String
		"A text to search for in the records, for example elk."
		q: String
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): NpsWebcamPage

	# Planning a visit: where to stay, where to park, what to do, and what it costs.

	"""
	Things visitors can do in national parks, such as hikes, scenic drives, wildlife viewing and ranger programs,
	each with its season, duration, fees, accessibility, and whether pets may come along: arePetsPermitted and
	arePetsPermittedWithRestrictions say yes or no, and petsDescription gives the rules. Use it for questions such
	as "can I take my dog on a trail in Rocky Mountain National Park" (parkCode romo, where pets may join the scenic
	drives and picnics, and stay off every trail).
	Returns activities and experiences visitors can do at National Park Service sites, with optional filters for
	IDs, park codes, state codes, or a search term.
	"""
	npsThingsToDo(
		"A comma delimited list of things to do IDs."
		id: String
		"""
		One park code, or several separated by commas: romo for Rocky Mountain National Park, grsa for Great Sand Dunes,
		meve for Mesa Verde, blca for Black Canyon of the Gunnison. npsParks with stateCode CO lists the codes of every
		site in Colorado.
		"""
		parkCode: String
		"One two-letter state code, or several separated by commas, for example CO for Colorado."
		stateCode: String
		"A text to search for in the records, for example elk."
		q: String
		"""
		The fields to sort by, separated by commas. A field starting with a minus sign sorts in descending order, for
		example -relevanceScore.
		"""
		sort: String
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): NpsThingToDoPage

	"""
	The campgrounds of national parks, with their number of sites, reservations, fees, amenities such as toilets,
	showers and potable water, accessibility, and opening seasons, for example the five campgrounds of Rocky
	Mountain National Park (parkCode romo).
	Returns campground information, with optional filters for park codes, state codes, or a search term.
	"""
	npsCampgrounds(
		"""
		One park code, or several separated by commas: romo for Rocky Mountain National Park, grsa for Great Sand Dunes,
		meve for Mesa Verde, blca for Black Canyon of the Gunnison. npsParks with stateCode CO lists the codes of every
		site in Colorado.
		"""
		parkCode: String
		"One two-letter state code, or several separated by commas, for example CO for Colorado."
		stateCode: String
		"A text to search for in the records, for example elk."
		q: String
		"""
		The fields to sort by, separated by commas. A field starting with a minus sign sorts in descending order, for
		example -relevanceScore.
		"""
		sort: String
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): NpsCampgroundPage

	"""
	The visitor centers and contact stations of national parks, with their opening hours, address, directions and
	amenities.
	Returns information about National Park Service visitor centers, with optional filters for park codes, state
	codes, or a search term.
	"""
	npsVisitorCenters(
		"""
		One park code, or several separated by commas: romo for Rocky Mountain National Park, grsa for Great Sand Dunes,
		meve for Mesa Verde, blca for Black Canyon of the Gunnison. npsParks with stateCode CO lists the codes of every
		site in Colorado.
		"""
		parkCode: String
		"One two-letter state code, or several separated by commas, for example CO for Colorado."
		stateCode: String
		"A text to search for in the records, for example elk."
		q: String
		"""
		The fields to sort by, separated by commas. A field starting with a minus sign sorts in descending order, for
		example -relevanceScore.
		"""
		sort: String
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): NpsVisitorCenterPage

	"""
	What a visit to a national park costs: entrance fees per vehicle, person or motorcycle, the passes a park sells
	or accepts, timed entry reservations, and parking fees, for example the timed entry permits of Rocky Mountain
	National Park (parkCode romo).
	Returns information about fees and passes, with optional filters for park codes, state codes, or a search term.
	"""
	npsFeesAndPasses(
		"""
		One park code, or several separated by commas: romo for Rocky Mountain National Park, grsa for Great Sand Dunes,
		meve for Mesa Verde, blca for Black Canyon of the Gunnison. npsParks with stateCode CO lists the codes of every
		site in Colorado.
		"""
		parkCode: String
		"A text to search for in the records, for example elk."
		q: String
		"""
		The fields to sort by, separated by commas. A field starting with a minus sign sorts in descending order, for
		example -relevanceScore.
		"""
		sort: String
		"One two-letter state code, or several separated by commas, for example CO for Colorado."
		statecode: String
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): NpsFeesAndPassesPage

	"""
	Events in national parks, such as ranger talks, guided walks and night sky programs, with their dates, times,
	place, fees and whether they need a registration. dateStart and dateEnd limit the dates.
	Returns events associated with National Park Service sites, with optional filters for location, date, event
	type, tags, or search term.
	"""
	npsEvents(
		"""
		One park code, or several separated by commas: romo for Rocky Mountain National Park, grsa for Great Sand Dunes,
		meve for Mesa Verde, blca for Black Canyon of the Gunnison. npsParks with stateCode CO lists the codes of every
		site in Colorado.
		"""
		parkCode: String
		"A comma delimited list of organization site codes."
		organization: String
		"A comma delimited list of subject site codes."
		subject: String
		"A comma delimited list of portal site codes."
		portal: String
		"A comma delimited list of tags that must be included."
		tagsAll: String
		"A comma delimited list of tags that may be included."
		tagsOne: String
		"A comma delimited list of tags that must not be included."
		tagsNone: String
		"One two-letter state code, or several separated by commas, for example CO for Colorado."
		stateCode: String
		"The first day of the events, as YYYY-MM-DD."
		dateStart: String
		"The last day of the events, as YYYY-MM-DD."
		dateEnd: String
		"A comma delimited list of event types."
		eventType: String
		"A unique ID string for an event."
		id: String
		"A text to search for in the records, for example elk."
		q: String
		"""
		A flag to denote whether or not to expand the recurring events out into multiple records (one per event date).
		Default is false.
		"""
		expandRecurring: Boolean
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): NpsEventPage

	# The lists the other NPS fields refer to: activities, amenities and topics.

	"""
	The 40 kinds of activity the National Park Service names for its parks, such as hiking, camping, wildlife
	watching, astronomy and dog sledding, each with its id.
	Returns activities available at National Park Service sites, with optional filters for activity IDs or a search
	term.
	"""
	npsActivities(
		"One or more activity unique IDs."
		id: String
		"A text to search for in the records, for example elk."
		q: String
		"""
		The fields to sort by, separated by commas. A field starting with a minus sign sorts in descending order, for
		example -relevanceScore.
		"""
		sort: String
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): NpsActivityPage

	"""
	The national parks that offer an activity, for each kind of activity, such as every park where visitors can go
	dog sledding or horse trekking. An activity can list hundreds of parks, so narrow it with id or q.
	Returns activites parks information.
	"""
	npsActivityParks(
		"A comma delimited list of activity IDs."
		id: String
		"A text to search for in the records, for example elk."
		q: String
		"""
		The fields to sort by, separated by commas. A field starting with a minus sign sorts in descending order, for
		example -relevanceScore.
		"""
		sort: String
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): NpsActivityParkPage
}

"The answer of npsParks, as the National Park Service sends it."
type NpsParkPage {
	"The number of results across all pages, as text."
	total: String
	data: [NpsPark]
	"The number of results the service was asked for, as text."
	limit: String
	"The number of results skipped before this page, as text."
	start: String
}

"""
A national park, monument or historic site of the National Park Service, with its park code, description,
location, opening hours, fees and contacts.
"""
type NpsPark {
	activities: [NpsActivity]
	"Park addresses (physical and mailing)"
	addresses: [NpsAddress]
	"Information about contacting the park"
	contacts: NpsContacts
	"Introductory paragraph from the park homepage"
	description: String
	"Type of designation (eg, national park, national monument, national recreation area, etc)"
	designation: String
	"General overview of how to get to the park"
	directionsInfo: String
	"Link to page, if available, that provides additional detail on getting to the park"
	directionsUrl: String
	"Fee for entering the park"
	entranceFees: [NpsFee]
	"Passes available to provide entry into the park"
	entrancePasses: [NpsPass]
	"Additional fees associated with the park"
	fees: [NpsParkFee]
	"Full park name (with designation)"
	fullName: String
	"Park identification string"
	id: String
	"Park images"
	images: [NpsImage]
	"The latitude and longitude as text, for example lat:40.3556924, long:-105.6972879."
	latLong: String
	latitude: String
	longitude: String
	multimedia: [NpsMultimediaReference]
	"Short park name (no designation)"
	name: String
	"Hours and seasons when the park is open or closed"
	operatingHours: [NpsOperatingHours]
	"The code of the park, such as romo for Rocky Mountain National Park."
	parkCode: String
	"""
	The relevance score is a numeric calculation of how much your item meets the criteria of your q (query text)
	search. This is normally coupled with a sort value of -relevanceScore. A higher value means that your item meets
	the criteria of the q search with a higher frequency and accuracy.
	"""
	relevanceScore: Float
	"State(s) the park is located in (comma-delimited list)"
	states: String
	topics: [NpsTopic]
	"Park Website"
	url: String
	"General description of the weather in the park over the course of a year"
	weatherInfo: String
}

"The activities of a park, as the National Park Service sends it."
type NpsActivity {
	"UUID for this activity"
	id: String
	"name for this activity"
	name: String
}

"The addresses of a park, as the National Park Service sends it."
type NpsAddress {
	postalCode: String
	city: String
	stateCode: String
	countryCode: String
	provinceTerritoryCode: String
	line1: String
	type: String
	line3: String
	line2: String
}

"Information about contacting the park"
type NpsContacts {
	phoneNumbers: [NpsPhoneNumber]
	emailAddresses: [NpsEmailAddress]
}

"The phoneNumbers of a contacts, as the National Park Service sends it."
type NpsPhoneNumber {
	phoneNumber: String
	description: String
	extension: String
	type: String
}

"The emailAddresses of a contacts, as the National Park Service sends it."
type NpsEmailAddress {
	emailAddress: String
	description: String
}

"One fee, with its cost in US dollars as text."
type NpsFee {
	cost: String
	description: String
	title: String
}

"The entrancePasses of a park, as the National Park Service sends it."
type NpsPass {
	cost: String
	description: String
	title: String
}

"The fees of a park, as the National Park Service sends it."
type NpsParkFee {
	cost: String
	description: String
	title: String
}

"""
A photo of the National Park Service, with its caption, credit and the text that describes it for people who
cannot see it.
"""
type NpsImage {
	"credit for this image"
	credit: String
	"alternate text for this image"
	altText: String
	"title for this image"
	title: String
	"caption for this image"
	caption: String
	"URL to this image"
	url: String
	"description for this image"
	description: String
	crops: [NpsImageCrop]
	imageId: String
	ordinal: String
	path: String
	imageid: String
	id: String
}

"The multimedia of a park, as the National Park Service sends it."
type NpsMultimediaReference {
	"title of multimedia asset"
	title: String
	"UUID for multimedia asset"
	id: String
	"the kind of asset"
	type: String
	"The URL of the multimedia asset"
	url: String
}

"""
When a place in a national park is open, as standard hours for each day of the week and exceptions for given
dates.
"""
type NpsOperatingHours {
	name: String
	description: String
	standardHours: NpsStandardHours
	exceptions: [NpsHoursException]
}

"The standardHours of an operating hours, as the National Park Service sends it."
type NpsStandardHours {
	sunday: String
	monday: String
	tuesday: String
	wednesday: String
	thursday: String
	friday: String
	saturday: String
}

"The exceptions of an operating hours, as the National Park Service sends it."
type NpsHoursException {
	name: String
	startDate: String
	endDate: String
	exceptionHours: NpsStandardHours
}

"The topics of a park, as the National Park Service sends it."
type NpsTopic {
	"UUID for this topic"
	id: String
	"name for this topic"
	name: String
}

"The answer of npsAlerts, as the National Park Service sends it."
type NpsAlertPage {
	"The number of results across all pages, as text."
	total: String
	data: [NpsAlert]
	"The number of results the service was asked for, as text."
	limit: String
	"The number of results skipped before this page, as text."
	start: String
}

"""
A notice that national park staff posted about their park, in the category Park Closure, Danger, Caution or
Information. It is a park notice, written by the park.
"""
type NpsAlert {
	"Park Closure, Danger, Caution or Information."
	category: String
	"Alert description"
	description: String
	"Unique identifier for an alert record"
	id: String
	"A variable width character code that uniquely identifies a specific park"
	parkCode: String
	"Alert title"
	title: String
	"Link to more information about the alert, if available"
	url: String
	"date/time stamp of when this alert was last indexed"
	lastIndexedDate: String
	"more information about a road event related to this alert (if any)"
	relatedRoadEvents: [NpsRelatedRoadEvent]
}

"The relatedRoadEvents of an alert, as the National Park Service sends it."
type NpsRelatedRoadEvent {
	"title of this related road event"
	title: String
	"UUID for this related road event"
	id: String
	"what type of related road event is this"
	type: String
	"URL for more information about this related road event"
	url: String
}

"The answer of npsRoadEvents, as the National Park Service sends it."
