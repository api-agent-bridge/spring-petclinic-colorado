"""
Something visitors can do in a national park, with its season, duration, fees, and the rules for pets.
"""
type NpsThingToDo {
	location: String
	seasonDescription: String
	accessibilityInformation: String
	longitude: String
	"Id for Geometry Point of Interest"
	geometryPoiId: String
	relatedParks: [NpsRelatedPark]
	"true or false"
