{"total_results":66,"page":1,"per_page":5,"results":[{"id":66408,"title":"Denver EcoFlora Project","hide_title":false,"hide_leaderboard":false,"description":"<a href=\"https://www.botanicgardens.org/science-research/biodiversity-research/citizen-science\">Learn more about the EcoFlora Project</a><BR>\r\n<a href=\"https://botanicgardens.us2.list-manage.com/subscribe?u=cbad7b587235ab57c0ed048d8&id=46ae68fad9\">Sign up for monthly EcoQuests</a><BR>\r\nThis project is designed to community members with biodiversity and has two main goals: 1) to meaningfully engage community members in observing, protecting, and preserving the metro area’s native plant species, and 2) to assemble novel observations and data on the metro area’s flora to better inform policy decisions concerning land management and conservation strategies.\r\n\r\nIt is fun and easy to participate! First, download the iNaturalist app onto your smartphone. If you have never used iNaturalist before, there are several tutorials that can assist you:\r\nhttps://www.inaturalist.org/pages/getting+started\r\nhttps://www.youtube.com/watch?v=xENz1xRu0wI\r\n\r\nIn the iNaturalist app, simply click on the green + sign at the bottom right of the screen. This is how you add a new observation. Click on “take photo” and take a photo of your observation. You can take multiple photos of the same observation, focusing on different features of the plant. For the best identifications, it is best to get photos of the flower and leaves. \r\n\r\nIf you think you know the identification, you can add this to your observation. If you don’t know what it is, don’t worry! iNaturalist may suggest identifications for you or you can leave this blank for identification later. Click on the check mark on the upper right of your screen to finish the observation. It’s that easy! You can always revisit and edit your observations later by going to “My Observations.” \r\n\r\nIf you are inside the Denver-Boulder metro area, your observation will automatically be added to the Denver EcoFlora Project on iNaturalist. To view ALL of the observations on the Denver EcoFlora Project, simply search for the “Denver EcoFlora Project” on your smartphone or go online to: https://www.inaturalist.org/projects/denver-ecoflora-project. ","slug":"denver-ecoflora-project","project_type":"collection","delegated_project_id":null,"is_delegated_umbrella":false,"banner_color":"#0a1475","place_id":131251,"user_id":601645,"admins":[{"id":720444,"user_id":601645,"project_id":66408,"role":"manager","user":{"id":601645,"login":"member36","spam":false,"suspended":false,"created_at":"2017-08-24T15:39:31+00:00","login_autocomplete":"member36","login_exact":"member36","name":"Member 36","name_autocomplete":"Member 36","orcid":null,"icon":null,"observations_count":5087,"identifications_count":34605,"journal_posts_count":0,"activity_count":39692,"species_count":1636,"annotated_observations_count":22,"universal_search_rank":5087,"roles":[],"site_id":1,"icon_url":null}},{"id":1088397,"user_id":4058635,"project_id":66408,"role":"manager","user":{"id":4058635,"login":"member37","spam":false,"suspended":false,"created_at":"2021-03-01T20:25:49+00:00","login_autocomplete":"member37","login_exact":"member37","name":null,"name_autocomplete":null,"orcid":null,"icon":null,"observations_count":173,"identifications_count":518,"journal_posts_count":0,"activity_count":691,"species_count":94,"annotated_observations_count":1,"universal_search_rank":173,"roles":[],"site_id":1,"icon_url":null}},{"id":1918238,"user_id":1079644,"project_id":66408,"role":"manager","user":{"id":1079644,"login":"member38","spam":false,"suspended":false,"created_at":"2018-07-11T01:18:04+00:00","login_autocomplete":"member38","login_exact":"member38","name":"Member 38","name_autocomplete":"Member 38","orcid":null,"icon":null,"observations_count":1894,"identifications_count":1148,"journal_posts_count":0,"activity_count":3042,"species_count":944,"annotated_observations_count":4,"univers