,5067858,5174654,5305979,5401675,5409709,5413057,5429431,5444693,5452254,5467754,5487270,5564004,5640070,5640295,5641541,5649688,5653260,5661928,5686781,5691693,5731976,5766122,5770378,5770383,5807329,5811630,5834727,5888089,5892015,5906778,5932064,5949076,5985007,6096805,6114174,6127426,6160614,6244566,6372323,6374351,6433038,6479320,6513281,6593166,6626308,6684260,6739857,6746861,6748017,6862721,7063367,7090304,7123701,7124211,7147438,7223610,7240273,7429171,7430505,7450327,7527322,7555820,7576228,7715326,7717624,7745587,7868476,8116268,8228367,8239600,8318802,8367442,8414837,8472603,8581696,8713903,8762295,8870799,8872161,8948971,8963959,9075022,9450185,10202773,10213691,10342912,10568485,10678436,10730024,10783247,11023952,11026587],"location":null,"icon":"https://static.inaturalist.org/projects/66408-icon-span2.jpg?1582562134","icon_file_name":"DBG_Logo_Color_square.jpg","header_image_url":"https://static.inaturalist.org/projects/66408-cover.jpg?1582562135","header_image_file_name":"20180604_highline-canal_008_cropped.jpg","header_image_contain":false,"project_observation_fields":[],"terms":null,"search_parameters":[{"field":"quality_grade","value":["research","needs_id"],"value_keyword":["research","needs_id"]},{"field":"taxon_id","value":[47126,47170],"value_number":[47126,47170]},{"field":"place_id","value":[131251],"value_number":[131251]}],"project_observation_rules":[{"id":258031,"operator":"observed_in_place?","operand_type":"Place","operand_id":131251},{"id":276614,"operator":"in_taxon?","operand_type":"Taxon","operand_id":47126},{"id":801738,"operator":"in_taxon?","operand_type":"Taxon","operand_id":47170}],"rule_preferences":[{"field":"quality_grade","value":"research,needs_id"}],"created_at":"2020-02-24T16:35:35+00:00","updated_at":"2026-09-13T19:36:36+00:00","flags":[],"site_features":[],"prefers_user_trust":false,"membership_model":"open","observation_requirements_updated_at":"2020-02-24T16:35:35+00:00","is_umbrella":false,"is_new_style_project":true,"user":{"id":601645,"login":"member36","spam":false,"suspended":false,"created_at":"2017-08-24T15:39:31+00:00","login_autocomplete":"member36","login_exact":"member36","name":"Member 36","name_autocomplete":"Member 36","orcid":null,"icon":null,"observations_count":5087,"identifications_count":34605,"journal_posts_count":0,"activity_count":39692,"species_count":1636,"annotated_observations_count":22,"universal_search_rank":5087,"roles":[],"site_id":1,"icon_url":null}},{"id":31030,"title":"City Nature Challenge 2019: Boulder-Denver Metro Area","hide_title":false,"hide_leaderboard":false,"description":"Which city in the world has the most nature? More importantly, which city’s residents are most engaged in that nature? Of course, the answer is Boulder-Denver Metro Area, but we need your help to prove it! Join the 2019 City Nature Challenge, and help Boulder & Denver compete against over 120 cities around the world to see which can document the most wild nature in only 4 days! This challenge is organized by: Colorado Parks & Wildlife, Metro Denver Nature Alliance, The Nature Conservancy, and the WILD Foundation. <a href=\"https://www.wild.org/naturechallenge\">Learn more here.</a>\n\n<strong>Organizations Supporting this Event:</strong> Bird Conservancy of the Rockies, Bluff Lake Nature Center, Boulder County Parks & Open Space, Butterfly Pavilion, City of Boulder Open Space & Mountain Parks, Finkel & Garf Brewing Co., Denver Audubon, Majestic View Nature Center, Regis University, Rocky Mountain Wild, University of Colorado Boulder \n\nParticipating is easy! Just download the free iNaturalist app, then get outside and start taking pictures of the nature around you! Observe any *wild* plants, animals, or fungi in state parks, open spaces, city parks, your backyard, or even cracks in the pavement. It’s all city nature! Just no pets or house/garden plants, please. Post your observations to the iNaturalist app April 26-29, 2019, and the community of naturalist will help identify them! You can also use our Denver Metro Area CNC plant, animal, and Bug Guides (found in the Guides Section of iNat) to ID observations yourself! If you’re unable to go out and make observations, you can still help by identifying observations, April 30-May 5, 2019. This is incredibly important because we can only count observations that are identified to the species level.\n\nBy participating, you will not only help Boulder-Denver win the competition; you will also be contributing crucial data about Boulder-Denver’s unique biodiversity. Scientists can then use this information to make important decisions about how to protect and improve urban nature. This is data that could never be collected without the help of citizen scientists like you! \n\nIn last year’s City Nature Challenge, 69 cities together made over 431,000 observations. Over 18,300 species were identified, 967 of which were endangered, threatened, or rare! While this is a “competition” between cities, everyone is a winner in the end because with each observation we all learn more about the nature around us. We hope you'll participate in City Nature Challenge this year, not only to help Boulder-Denver win, but also to help increase scientific knowledge of the urban-nature interface. Thank you, and may the best city (Boulder-Denver) win!","slug":"city-nature-challenge-2019-boulder-denver-metro-area","project_type":"collection","delegated_project_id":null,"is_delegated_umbrella":false,"banner_color":"#28387d","place_id":131251,"user_id":85539,"admins":[{"id":440008,"user_id":85539,"project_id":31030,"role":"manager","user":{"id":85539,"login":"member39","spam":false,"suspended":false,"created_at":"2015-03-26T18:31:11+00:00","login_autocomplete":"member39","login_exact":"member39","name":"Member 39","name_autocomplete":"Member 39","orcid":null,"icon":null,"observations_count":389,"identifications_count":386,"journal_posts_count":0,"activity_count":775,"species_count":219,"annotated_observations_coun