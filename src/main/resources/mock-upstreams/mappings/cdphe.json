    {
      "name": "CDPHE cases: Denver County, every year",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPath": "/cdphe/arcgis/services/OPEN_DATA/cdphe_reportable_disease_dataset/MapServer",
        "bodyPatterns": [
          {
            "matchesXPath": "//WhereClause[.=\"diagnosis IN ('Rabies, Animal','Plague, Animal','Tularemia, Animal') AND metric = 'county' AND UPPER(category) = 'DENVER'\"]"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "text/xml; charset=UTF-8"
        },
        "bodyFileName": "cdphe/cases-denver.xml"
      },
      "metadata": {
        "description": "Rabies, plague and tularemia in animals in Denver County, 2016 to 2025"
      }
    },
    {
      "name": "CDPHE cases: rabies in Colorado per year",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPath": "/cdphe/arcgis/services/OPEN_DATA/cdphe_reportable_disease_dataset/MapServer",
        "bodyPatterns": [
          {
            "matchesXPath": "//WhereClause[.=\"diagnosis IN ('Rabies, Animal') AND metric = 'state'\"]"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "text/xml; charset=UTF-8"
        },
        "bodyFileName": "cdphe/cases-rabies-state.xml"
      },
      "metadata": {
        "description": "Animals with rabies in the whole state, 2016 to 2025"
      }
    },
