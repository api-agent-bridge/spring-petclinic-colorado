{
  "mappings": [
    {
      "name": "CDPHE: unknown map name",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPathPattern": "/cdphe/arcgis/services/.*/MapServer",
        "bodyPatterns": [
          {
            "matchesXPath": "//MapName[text() != 'Layers']"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "text/xml; charset=UTF-8"
        },
        "bodyFileName": "cdphe/fault-unknown-map-name.xml"
      },
      "metadata": {
        "description": "ArcGIS Server answers a wrong map name with a SOAP fault and HTTP status 200, recorded on the animals map"
      }
    },
    {
      "name": "CDPHE animals: domestic animals",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPath": "/cdphe/arcgis/services/DCEED/ZOONOTIC_SUMMARY_POSITIVE_ANIMALS_2017/MapServer",
        "bodyPatterns": [
          {
            "matchesXPath": "//WhereClause[.=\"Specimen_Type LIKE 'Domestic Animal%' ESCAPE '\\'\"]"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "text/xml; charset=UTF-8"
        },
        "bodyFileName": "cdphe/animals-domestic.xml"
      },
      "metadata": {
        "description": "The 9 domestic animals: 6 cats with plague, 1 cat with tularemia and 2 dogs with rabies"
      }
    },
    {
      "name": "CDPHE animals: bats in Boulder County",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPath": "/cdphe/arcgis/services/DCEED/ZOONOTIC_SUMMARY_POSITIVE_ANIMALS_2017/MapServer",
        "bodyPatterns": [
          {
            "matchesXPath": "//WhereClause[.=\"UPPER(Species) LIKE '%BAT%' ESCAPE '\\' AND UPPER(County) = 'BOULDER'\"]"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "text/xml; charset=UTF-8"
        },
        "bodyFileName": "cdphe/animals-bats-boulder.xml"
      },
      "metadata": {
        "description": "The 5 rabid big brown bats of Boulder County"
      }
    },
    {
      "name": "CDPHE animals: every animal",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPath": "/cdphe/arcgis/services/DCEED/ZOONOTIC_SUMMARY_POSITIVE_ANIMALS_2017/MapServer",
        "bodyPatterns": [
          {
            "matchesXPath": "//WhereClause[.=\"1=1\"]"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "text/xml; charset=UTF-8"
        },
        "bodyFileName": "cdphe/animals-all.xml"
      },
      "metadata": {
        "description": "All 341 animals and mosquito pools of the 2017 map"
      }
    },
    {
      "name": "CDPHE animals: any other filter on domestic animals",
      "priority": 3,
      "request": {
        "method": "POST",
        "urlPath": "/cdphe/arcgis/services/DCEED/ZOONOTIC_SUMMARY_POSITIVE_ANIMALS_2017/MapServer",
        "bodyPatterns": [
          {
            "matchesXPath": "//WhereClause[contains(., \"'Domestic Animal%'\")]"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "text/xml; charset=UTF-8"
        },
        "bodyFileName": "cdphe/animals-domestic.xml"
      },
      "metadata": {
        "description": "The 9 domestic animals, whatever the other filters are"
      }
    },
