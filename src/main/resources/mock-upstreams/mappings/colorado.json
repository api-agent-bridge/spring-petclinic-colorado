{
  "mappings": [
    {
      "name": "Colorado vet licenses: count, helen-leary",
      "priority": 2,
      "request": {
        "method": "GET",
        "urlPath": "/colorado/resource/7s5z-vewr.json",
        "queryParameters": {
          "$select": {
            "equalTo": "count(*)"
          },
          "$where": {
            "equalTo": "licensetype in ('VET', 'VT', 'AV', 'PVT') AND starts_with(upper(lastname), 'LEARY') AND starts_with(upper(firstname), 'HELEN')"
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "bodyFileName": "colorado/vet-licenses-count-helen-leary.json"
      },
      "metadata": {
        "description": "The number of veterinary rows for helen-leary, recorded from https://data.colorado.gov/resource/7s5z-vewr.json"
      }
    },
